{{define "body"}}
  {{ template "header" . }}
  <div class="drawer lg:drawer-open min-h-[calc(100vh-4rem)]">
    <input id="settings-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content flex flex-col max-w-5xl mx-auto w-full">
      <div class="flex items-center gap-2 px-4 py-3 border-b border-base-300 lg:hidden">
        <label for="settings-drawer" class="btn btn-ghost drawer-button">
          {{ template "menu-icon" . }}
          Settings
        </label>
      </div>
      <main class="flex-1 p-8">{{ template "page" . }}</main>
    </div>
    <div class="drawer-side z-10">
      <label for="settings-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
      <aside class="w-56 shrink-0 border-r border-base-300 pt-8 px-3 flex flex-col gap-0.5 bg-base-100 min-h-full">
        <p class="px-3 pb-2 text-xs font-medium text-neutral uppercase tracking-wider">Org</p>
        <a href="/orgs/{{ .Data.OrgID }}"
           class="flex items-center px-3 py-1.5 rounded text-sm {{ block "sidebar-general" . }}hover:bg-base-200{{ end }}">
          General
        </a>
        <a href="/orgs/{{ .Data.OrgID }}/settings"
           class="flex items-center px-3 py-1.5 rounded text-sm {{ block "sidebar-billing" . }}hover:bg-base-200{{ end }}">
          Billing &amp; Tax
        </a>
        <a href="/orgs/{{ .Data.OrgID }}/settings/equipment-categories"
           class="flex items-center px-3 py-1.5 rounded text-sm {{ block "sidebar-categories" . }}hover:bg-base-200{{ end }}">
          Equipment Categories
        </a>
        <a href="/orgs/{{ .Data.OrgID }}/settings/manufacturers"
           class="flex items-center px-3 py-1.5 rounded text-sm {{ block "sidebar-manufacturers" . }}hover:bg-base-200{{ end }}">
          Manufacturers
        </a>
      </aside>
    </div>
  </div>
  {{ template "footer" . }}
{{end}}
