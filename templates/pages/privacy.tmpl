{{ define "title" }}Privacy Policy{{ end }}
{{ define "description" }}Privacy policy for Gearberg. No personal data is collected on this website.{{ end }}

{{ define "page" }}
<main class="container mx-auto px-6 max-w-3xl py-24">
  <hgroup class="mb-10">
    <h1 class="text-4xl font-bold">Privacy Policy</h1>
    <p class="mt-2 opacity-70">Last updated: May 29th, 2026</p>
  </hgroup>

  <section class="mb-8" aria-labelledby="overview-heading">
    <p>This Privacy Policy explains how we handle your data when you use this website. We do not collect any personal data. You may browse all content without providing any personal information.</p>
  </section>

  <section class="mb-8" aria-labelledby="data-heading">
    <h2 id="data-heading" class="text-xl font-semibold mb-3">Data Processing on This Website</h2>
    <p>No personal data is collected through this website. No cookies are set, no tracking scripts are loaded, and no analytics are performed.</p>
  </section>

  <section class="mb-8" aria-labelledby="rights-heading">
    <h2 id="rights-heading" class="text-xl font-semibold mb-3">Your Rights</h2>
    <p>As a data subject under GDPR you have the right to access, rectify, erase, restrict, and port your data, and to object to processing. Since no data is collected here, these rights are not applicable to this website.</p>
  </section>

  <section class="mb-8" aria-labelledby="changes-heading">
    <h2 id="changes-heading" class="text-xl font-semibold mb-3">Changes to This Policy</h2>
    <p>We may update this policy from time to time. The updated version will be posted on this page with a new "Last updated" date.</p>
  </section>

  <section aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="text-xl font-semibold mb-3">Contact</h2>
    <p>Tobias Gleiter &mdash; <a href="mailto:gleiter.tobias@outlook.de" class="link link-primary">gleiter.tobias@outlook.de</a></p>
  </section>
</main>
{{ end }}
