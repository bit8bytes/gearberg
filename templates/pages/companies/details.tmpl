{{ define "title" }}General{{ end }}
{{ define "sidebar-general" }}bg-base-300 font-semibold{{ end }}

{{ define "page" }}
<div class="max-w-xl">
  <h2 class="mb-1">General</h2>
  <p class="text-sm text-neutral mb-6">Company name and basic information.</p>

  <form method="POST" action="/companies/{{ .Data.CompanyID }}" class="flex flex-col gap-4" novalidate>
    <div class="flex flex-col gap-1">
      <label for="name">Name</label>
      <input
        id="name"
        type="text"
        name="name"
        value="{{ if .Data.Company }}{{ .Data.Company.Name }}{{ else }}{{ .Form.Name }}{{ end }}"
        maxlength="100"
        class="input"
      />
      {{ with index .Form.Errors "name" }}
        <p class="text-red-500 text-sm">{{ . }}</p>
      {{ end }}
    </div>

    <div>
      <button type="submit" class="btn btn-primary">Save</button>
    </div>
  </form>

  <div class="mt-10 border-t pt-6">
    <h3 class="mb-1">Storage</h3>
    <p class="text-sm text-neutral mb-4">{{ .Data.StorageUsage.Used }} of {{ .Data.StorageUsage.Max }} used</p>
    <progress class="progress w-full" value="{{ .Data.StorageUsage.Percent }}" max="100"></progress>
  </div>

  <div class="mt-10 border-t border-error pt-6">
    <h3 class="mb-1 text-error">Danger Zone</h3>
    <p class="text-sm text-neutral mb-4">Permanently delete this company and all associated data.</p>
    <button class="btn btn-error" onclick="delete_company_modal.showModal()">Delete Company</button>
  </div>
</div>

<dialog id="delete_company_modal" class="modal">
  <div class="modal-box">
    <h3>Delete Company</h3>
    <p class="py-4">Are you sure you want to permanently delete this company and all associated data? This action cannot be undone.</p>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn">Cancel</button>
      </form>
      <form method="POST" action="/companies/{{ .Data.CompanyID }}/delete">
        <button type="submit" class="btn btn-error">Delete</button>
      </form>
    </div>
  </div>
</dialog>
{{ end }}
