{{ define "title" }}{{ if .Output }}{{ if .Output.Category }}{{ .Output.Category.Name }}{{ end }}{{ end }}{{ end }}

{{ define "page" }}
<div class="flex-1 max-w-xs mx-auto mt-8">
  <div class="flex items-center justify-between mb-6">
    <h1>Edit Category</h1>
    <a href="/companies/{{ .Input.CompanyID }}/settings/equipment-categories" class="btn">Back</a>
  </div>

  <form method="POST" class="flex flex-col gap-4" novalidate>
    <div class="flex flex-col gap-1">
      <label for="name">Name</label>
      <input
        id="name"
        type="text"
        name="name"
        value="{{ if .Input.Name }}{{ .Input.Name }}{{ else if .Output }}{{ if .Output.Category }}{{ .Output.Category.Name }}{{ end }}{{ end }}"
        maxlength="100"
        class="input"
      />
      {{ with index .Errors "name" }}
        <p class="text-red-500 text-sm">{{ . }}</p>
      {{ end }}
    </div>

    <div class="flex gap-1 items-center">
      <button type="submit" formaction="/companies/{{ .Input.CompanyID }}/settings/equipment-categories/{{ .Input.ID }}" class="btn btn-primary">Save</button>
      <button formaction="/companies/{{ .Input.CompanyID }}/settings/equipment-categories/{{ .Input.ID }}/delete" type="submit" class="btn btn-error btn-outline">Delete</button>
    </div>
  </form>

</div>
{{ end }}
