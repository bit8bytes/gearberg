{{define "page"}}
<div class="flex-1 max-w-xs mx-auto mt-8 px-4">
  <div class="flex items-center justify-between mb-6">
    <h1>Companies</h1>
    {{ if ge (len .Data.Companies) .Data.MaxCompanies }}
    <div class="tooltip" data-tip="Maximum of {{ .Data.MaxCompanies }} companies reached">
      <button class="btn btn-primary" disabled>+ New</button>
    </div>
    {{ else }}
    <a href="/companies/new" class="btn btn-primary">+ New</a>
    {{ end }}
  </div>

  {{ with .Data.Companies }}
  <ul class="flex flex-col divide-y divide-base-300 border border-base-300 rounded-box overflow-hidden">
    {{ range . }}
    <li>
      <a href="/companies/{{ .ID }}/inventory" class="list-item-link">
        {{ template "companies-icon" . }}
        <span class="flex-1 font-medium">{{ .Name }}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-base-content/40"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </li>
    {{ end }}
  </ul>
  {{ else }}
  <div class="flex flex-col items-center gap-3 py-16 text-base-content/40">
    {{ template "companies-icon" . }}
    <p class="text-sm">No companies yet.</p>
  </div>
  {{ end }}
</div>
{{end}}
