{{ define "title" }}New Org{{ end }}

{{ define "page" }}
<div class="flex-1 max-w-xs mx-auto mt-8">
  <h1 class="">New Org</h1>

  <form method="POST" action="/orgs/new" class="mt-4 flex flex-col gap-4" novalidate>
    <div class="flex flex-col gap-1">
      <label for="name">Name</label>
      <input
        id="name"
        type="text"
        name="name"
        value="{{ .Form.Name }}"
        maxlength="100"
        class="input"
      />
      {{ with index .Form.Errors "name" }}
        <p class="text-red-500 text-sm">{{ . }}</p>
      {{ end }}
    </div>

    <div class="flex gap-2">
      <button type="submit" class="btn btn-primary">Create</button>
      <a href="/" class="btn">Cancel</a>
    </div>
  </form>
</div>
{{ end }}
