{{ define "title" }}Add Item{{ end }}

{{ define "page" }}
<div class="flex-1 max-w-xs mx-auto mt-8">
  <h1 class="">Add Item</h1>

  <form method="POST" action="/orgs/{{ .Data.OrgID }}/inventory/new" enctype="multipart/form-data" class="mt-4 flex flex-col gap-4" novalidate>

    <div class="flex flex-col gap-1">
      <label>Photo</label>
      <label for="image" class="cursor-pointer w-24 h-24 rounded-lg border-2 border-dashed border-base-300 bg-base-200 flex items-center justify-center overflow-hidden" data-image-preview>
        {{ template "camera-icon" . }}
        <img class="hidden w-full h-full object-cover" data-image-preview-img alt="Preview" />
      </label>
      <input id="image" type="file" name="image" accept="image/jpeg,image/png" class="hidden" data-image-input />
    </div>

    <div class="flex flex-col gap-1">
      <label for="name">Name</label>
      <input
        id="name"
        type="text"
        name="name"
        value="{{ .Form.Name }}"
        maxlength="200"
        class="input"
      />
      {{ with index .Form.Errors "name" }}
        <p class="text-red-500 text-sm">{{ . }}</p>
      {{ end }}
    </div>

    <div class="flex flex-col gap-1">
      <label for="category_id">Category</label>
      <select id="category_id" name="category_id" class="select">
        <option value="">Select a category</option>
        {{ range .Data.Categories }}
          <option value="{{ .ID }}" {{ if eq $.Form.CategoryID .ID }}selected{{ end }}>{{ .Name }}</option>
        {{ end }}
      </select>
      {{ with index .Form.Errors "category_id" }}
        <p class="text-red-500 text-sm">{{ . }}</p>
      {{ end }}
    </div>

    <div class="flex flex-col gap-1">
      <label for="total_stock">Total Stock</label>
      <input
        id="total_stock"
        type="number"
        name="total_stock"
        value="{{ if .Form.TotalStock }}{{ .Form.TotalStock }}{{ else }}1{{ end }}"
        min="1"
        class="input"
      />
      {{ with index .Form.Errors "total_stock" }}
        <p class="text-red-500 text-sm">{{ . }}</p>
      {{ end }}
    </div>

    <div class="flex flex-col gap-1">
      <label for="notes">Notes</label>
      <textarea
        id="notes"
        name="notes"
        class="textarea"
        rows="3"
      >{{ .Form.Notes }}</textarea>
    </div>

    <div class="flex gap-2">
      <button type="submit" class="btn btn-primary">Add Item</button>
      <a href="/orgs/{{ .Data.OrgID }}/inventory" class="btn">Cancel</a>
    </div>

  </form>
</div>
{{ end }}
