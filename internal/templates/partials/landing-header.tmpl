{{ define "landing-header" }}
<div class="navbar">
  <div class="flex-1">
      {{ template "logo-with-text" . }}
  </div>
  <div class="flex-none text-secondary-content">
    <ul class="menu menu-horizontal px-1 gap-2">
      <li>
        <a 
          href="https://docs.gearberg.org" 
          class="btn btn-sm sm:btn-md tooltip tooltip-left" 
          aria-label="Documentation" 
          target="_blank" 
          rel="noopener noreferrer"
          data-tip="Go to Gearberg Docs">
        {{ template "docs-icon" . }}
        </a>
      </li>
      <li>
        <a href="https://github.com/bit8bytes/gearberg" class="btn btn-square btn-sm sm:btn-md" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
        {{ template "github-icon" . }}
        </a>
      </li>
    </ul>
  </div>
</div>
{{ end }}
