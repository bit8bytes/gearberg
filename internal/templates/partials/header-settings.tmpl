{{ define "header-settings" }}
<header class="border-b border-base-300">
  <div class="navbar bg-gray-950">
    <div class="flex-1 flex flex-row items-center gap-6">
      <span class="wordmark text-2xl text-white"><a href="/">Gear<span class="text-primary">berg</span></a></span>
    </div>
    <div class="flex gap-2">
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar avatar-placeholder">
          <div class="bg-primary text-primary-content w-24 rounded-full">
            <span>gb</span>
          </div>
        </div>
        <ul
          tabindex="-1"
          class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 gap-1 shadow">
          <div class="flex items-center gap-1">
            <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar avatar-placeholder">
              <div class="bg-neutral text-neutral-content w-24 rounded-full">
                <span>gb</span>
              </div>
            </div>
            Gearberg
          </div>
          <div class="border-b border-base-200"></div>
          <li>
            <a href="/settings/organizations" class="{{ if eq $.URL.Path "/settings/organizations" }}text-primary{{ end }}">
              <span class="size-6">{{ template "orgs-icon" . }}</span>
              Organizations
            </a>
          </li>
          <div class="border-b border-base-200"></div>
          <li>
            <a href="/settings/account" class="{{ if inPath $.URL.Path "/settings" }}text-primary{{ end }}">
              <span class="size-6">{{ template "settings-icon" . }}</span>
              Settings
            </a>
          </li>
          <div class="border-b border-base-200"></div>
          <li>
            <button class="w-full" hx-post="/signout">
              <span class="size-6">{{ template "logout-icon" . }}</span>
              Logout
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>
</header>
{{ end }}
