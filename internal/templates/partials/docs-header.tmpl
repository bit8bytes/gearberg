      {{ template "menu-icon" . }}
    </label>
  </div>
  <div class="flex-1">
    <span class="wordmark text-2xl pl-2"><a href="/">Gear<span class="text-primary">berg</span></a><span class="text-secondary text-xl"> Docs</span></span>
