{{ define "docs-header" }}
<div class="navbar">
  
  <div class="flex-1">
    {{ template "docs-logo-with-text" . }}
  </div>
  <div class="flex-none text-secondary-content">
    <ul class="menu menu-horizontal px-1 gap-2">
      <li>
        <a 
          href="https://github.com/bit8bytes/gearberg" 
          class="btn btn-square btn-sm sm:btn-md" 
          aria-label="GitHub" 
          target="_blank" 
          rel="noopener noreferrer"
          >
          {{ template "github-icon" . }}
        </a>
      </li>
      <li class="flex-none lg:hidden">
        <label 
          for="docs-drawer" 
          class="btn btn-square drawer-button"
          >
          {{ template "menu-icon" . }}
        </label>
      </li>
    </ul>
  </div>
</div>
{{ end }}
