{{ define "equipment-header" }}
<div class="w-full bg-base-200 border-b border-base-300">
  <div class="max-w-5xl mx-auto px-4 min-h-24 py-4 flex flex-col justify-center gap-1">
    <div class="breadcrumbs text-sm py-0">
      <ul>
        <li><a href="/orgs/{{ .Data.OrgID }}/equipment">Equipment</a></li>
        <li>{{ .Data.Item.Name }}</li>
      </ul>
    </div>
    {{ if .Data.PartOf }}
    <div class="flex items-center gap-1 text-xs text-base-content/50">
      <span>Part of:</span>
      {{ range $i, $p := .Data.PartOf }}{{ if $i }}, {{ end }}<a href="/orgs/{{ $.Data.OrgID }}/equipment/{{ $p.ID }}" class="link">{{ $p.Name }}</a>{{ end }}
    </div>
    {{ end }}
  </div>
</div>
{{ end }}
