{{ define "logo-with-text" }}
<span class="wordmark inline-flex gap-1 items-center text-2xl group">
  <span class="relative w-6 h-6">
    <span class="absolute inset-0 transition-opacity duration-50 opacity-100 group-hover:opacity-0">{{ template "logo" . }}</span>
    <span class="absolute inset-0 transition-opacity duration-50 opacity-0 group-hover:opacity-100">{{ template "logo-open" . }}</span>
  </span>
  <a href="/">Gear<span class="text-primary">berg</span></a>
</span>
{{ end }}

