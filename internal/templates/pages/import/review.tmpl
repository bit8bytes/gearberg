{{ define "title" }}Review Import{{ end }}

{{ define "page" }}
<div class="max-w-7xl mx-auto px-4 my-8 flex flex-col gap-6">

  <div>
    <a href="/orgs/{{ .Data.OrgID }}/import" class="text-xs font-semibold tracking-widest text-primary uppercase mb-1 hover:underline">&larr; Upload</a>
    <p class="text-3xl font-bold leading-tight">Review Import</p>
    <p class="text-sm text-base-content/60 mt-1">Review the rows below before confirming. Rows with errors are excluded automatically.</p>
  </div>

  <div class="flex gap-3 text-sm">
    <span class="badge badge-success badge-outline">{{ .Data.CountReady }} ready</span>
    <span class="badge badge-warning badge-outline">{{ .Data.CountPending }} pending</span>
    <span class="badge badge-error badge-outline">{{ .Data.CountError }} error</span>
  </div>

  {{ if gt .Data.CountPending 0 }}
  <div role="alert" class="alert alert-warning text-sm">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
    </svg>
    <span>{{ .Data.CountPending }} row(s) need your decision before you can confirm.</span>
  </div>
  {{ end }}

  <table class="table w-full">
    <thead>
      <tr>
        <th>#</th>
        <th>Name</th>
        <th>Status</th>
        <th>Error</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      {{ range .Data.Rows }}
      <tr class="{{ if eq .Status "error" }}opacity-40{{ end }}">
        <td class="text-base-content/50 text-xs">{{ .RowNumber }}</td>
        <td class="font-medium">{{ .Name }}</td>
        <td>
          {{ if eq .Status "error" }}
            <span class="badge badge-error badge-sm">Error</span>
          {{ else if eq .Status "needs_review" }}
            <span class="badge badge-warning badge-sm">Review</span>
          {{ else }}
            <span class="badge badge-success badge-sm">Ready</span>
          {{ end }}
        </td>
        <td class="text-xs text-error">{{ .ErrorMessage }}</td>
        <td>
          {{ if eq .Status "error" }}
            <span class="text-xs text-base-content/40">Skipped</span>
          {{ else }}
            <form method="POST" action="/orgs/{{ $.Data.OrgID }}/import/{{ $.Data.SessionID }}/review">
              <input type="hidden" name="row_id" value="{{ .ID }}" />
              {{ if eq .Action "skip" }}
                <input type="hidden" name="action" value="create" />
                <button class="btn btn-xs btn-ghost">Skipped — undo</button>
              {{ else }}
                <input type="hidden" name="action" value="skip" />
                <button class="btn btn-xs btn-ghost text-error">Skip</button>
              {{ end }}
            </form>
          {{ end }}
        </td>
      </tr>
      {{ end }}
    </tbody>
  </table>

  {{ if gt .Data.CountReady 0 }}
  <form method="POST" action="/orgs/{{ .Data.OrgID }}/import/{{ .Data.SessionID }}/confirm">
    <div class="flex gap-2">
      <button type="submit" class="btn btn-primary"
        {{ if gt .Data.CountPending 0 }}disabled title="Resolve all pending rows first"{{ end }}>
        Confirm Import
      </button>
      <a href="/orgs/{{ .Data.OrgID }}/equipment" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
  {{ else }}
  <div class="flex gap-2 items-center">
    <p class="text-sm text-base-content/60">Nothing to import — all rows have errors.</p>
    <a href="/orgs/{{ .Data.OrgID }}/import" class="btn btn-sm">Try again</a>
  </div>
  {{ end }}

</div>
{{ end }}
