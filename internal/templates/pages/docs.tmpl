            <th>Flag</th>
            <th>Env var</th>
            <th>Default</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code class="badge badge-neutral font-mono">-base-url</code></td>
            <td>—</td>
            <td>http://localhost:8080</td>
            <td>Public base URL</td>
          </tr>
          <tr>
            <td><code class="badge badge-neutral font-mono">-db-dsn</code></td>
            <td><code class="badge font-mono">DB_DSN</code></td>
            <td><code class="font-mono text-xs">file:/data/gearberg.db</code></td>
            <td>Database DSN</td>
          </tr>
          <tr>
            <td><code class="badge badge-neutral font-mono">-storage-dsn</code></td>
            <td><code class="badge font-mono">STORAGE_DSN</code></td>
            <td><code class="font-mono text-xs">file:///data/uploads</code></td>
            <td>Storage backend DSN</td>
          </tr>
          <tr>
            <td><code class="badge badge-neutral font-mono">-port</code></td>
            <td>—</td>
            <td><code class="font-mono text-xs">8080</code></td>
            <td>Port to listen on</td>
          </tr>
          <tr>
            <td><code class="badge badge-neutral font-mono">-log-level</code></td>
            <td>—</td>
            <td><code class="font-mono text-xs">error</code></td>
            <td><code class="font-mono text-xs">debug</code>, <code class="font-mono text-xs">info</code>, <code class="font-mono text-xs">warn</code>, <code class="font-mono text-xs">error</code></td>
          </tr>

          <tr class="bg-base-200/50">
            <td colspan="4" class="text-xs uppercase tracking-wider py-1">
              TLS:<span class="normal-case font-normal tracking-normal ml-2 text-base-content/40">Cert and key required when <code class="font-mono">-tls-mode=local</code></span>
            </td>
          </tr>
          <tr>
            <td><code class="badge badge-neutral font-mono">-tls-mode</code></td>
            <td>—</td>
            <td><code class="font-mono text-xs">off</code></td>
            <td><code class="font-mono text-xs">off</code> or <code class="font-mono text-xs">local</code></td>
          </tr>
          <tr>
            <td><code class="badge badge-neutral font-mono">-tls-cert-path</code></td>
            <td>—</td>
            <td>—</td>
            <td>TLS certificate</td>
          </tr>
          <tr>
            <td><code class="badge badge-neutral font-mono">-tls-key-path</code></td>
            <td><code class="badge font-mono">TLS_KEY_PATH</code></td>
            <td>—</td>
            <td>TLS key</td>
          </tr>

          <tr class="bg-base-200/50">
            <td colspan="4" class="text-xs uppercase tracking-wider py-1">Limits</td>
          </tr>
          <tr>
            <td><code class="badge badge-neutral font-mono">-max-orgs</code></td>
            <td>—</td>
            <td><code class="font-mono text-xs">1</code></td>
            <td>Maximum number of orgs</td>
          </tr>
          <tr>
            <td><code class="badge badge-neutral font-mono">-max-categories</code></td>
            <td>—</td>
            <td><code class="font-mono text-xs">25</code></td>
            <td>Equipment categories per org</td>
          </tr>
          <tr>
            <td><code class="badge badge-neutral font-mono whitespace-nowrap">-max-manufacturers</code></td>
            <td>—</td>
            <td><code class="font-mono text-xs">100</code></td>
            <td>Manufacturers per org</td>
          </tr>
          <tr>
            <td><code class="badge badge-neutral font-mono">-max-locations</code></td>
            <td>—</td>
            <td><code class="font-mono text-xs">100</code></td>
            <td>Locations per org</td>
          </tr>
          <tr>
            <td><code class="badge badge-neutral font-mono whitespace-nowrap">-max-storage-bytes</code></td>
            <td>—</td>
            <td><code class="font-mono text-xs">1073741824</code> <span class="text-base-content/60 text-xs">(1 GiB)</span></td>
            <td>Storage per org</td>
          </tr>

          <tr class="bg-base-200/50">
            <td colspan="4" class="text-xs uppercase tracking-wider py-1">
