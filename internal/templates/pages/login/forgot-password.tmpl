{{ define "title"}}Forgot Password{{ end }}
{{ define "notes" }}Request a password reset link for your Gearberg account{{end }}

{{ define "page" }}
<div class="flex flex-col items-center justify-center p-8 h-screen overflow-y-auto">
  <form action="/forgot-password" method="post">
    <fieldset class="fieldset bg-base-100 border-base-300 rounded-box w-xs border p-6">
      <div class="flex justify-center mb-2">{{ template "logo" . }}</div>
      <h1 class="text-xl font-bold text-center">Forgot Password</h1>
        <p class="text-center text-sm mt-1 mb-4">Enter your email and we'll send you a reset link.</p>

      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
          <label class="floating-label w-full">
            <input
              id="email"
              name="email"
              type="text"
              class="input w-full {{ with index .Form.Errors "email" }}input-error{{ end }}"
              placeholder="Email"
              value="{{ .Form.Email }}"
              autocomplete="email"
              {{ if index .Form.Errors "email" }}aria-describedby="email-error" aria-invalid="true"{{ end }}
            />
            <span>Email</span>
          </label>
          {{ with index .Form.Errors "email" }}
          <div class="label">
            <span id="email-error" class="label-text-alt text-error">{{ . }}</span>
          </div>
          {{ end }}
        </div>
      </div>

      <label for="website" class="label hidden">Website</label>
      <input
        id="website"
        type="hidden"
        name="website"
        tabindex="-1"
        autocomplete="off"
        class="input"
      />

      <button type="submit" class="btn btn-primary mt-4" data-loading-btn>
        <span class="size-4 rounded-full border-2 border-current border-t-transparent animate-spin hidden" data-loading-spinner></span>
        Send Reset Link
      </button>

      <p class="label justify-center">
        Already have an account?
        <a href="/signin" class="link link-hover">Login</a>
      </p>
    </fieldset>
  </form>
</div>
{{ end }}
