{{ define "title"}}Reset Password{{ end }}
{{ define "notes" }}Reset your password for filmlet{{end }}

{{ define "page" }}
<div class="flex flex-col items-center justify-center p-8 h-screen overflow-y-auto">
  <fieldset class="fieldset bg-base-100 border-base-300 rounded-box w-xs border p-4">
    <div class="flex justify-center mb-2">{{ template "logo" . }}</div>
    <h1 class="text-xl font-bold text-center">Check your email</h1>
    <p class="text-center text-sm mt-1 mb-2">
      If an account exists, we sent a password reset link. Check your inbox and follow the instructions.
    </p>
    <p class="label justify-center">
      <a href="/signin" class="link link-hover">Back to login</a>
    </p>
  </fieldset>
</div>
{{ end }}
