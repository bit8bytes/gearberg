{{ define "title"}}Signup{{ end }}
{{ define "notes" }}Signup to filmlet{{end }}

{{ define "page" }}
<div class="flex flex-col items-center justify-center p-8 h-screen overflow-y-auto">
  <form action="/signup" method="post">
    <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-xs border p-6">
      <div class="flex justify-center mb-2">{{ template "logo" . }}</div>
      <h1 class="text-xl font-bold text-center">Get Ready</h1>
      <p class="text-secondary-content text-center text-sm mt-1 mb-4">Create your account to get started.</p>

      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
          <label class="floating-label w-full">
            <input
              id="email"
              name="email"
              type="email"
              class="input w-full {{ with .Form.Errors.email }}input-error{{ end }}"
              placeholder="Email"
              value="{{ .Form.Email }}"
              autocomplete="email"
              {{ if .Form.Errors.email }}aria-describedby="email-error" aria-invalid="true"{{ end }}
            />
            <span>Email</span>
          </label>
          {{ with .Form.Errors.email }}
          <div class="label">
            <span id="email-error" class="label-text-alt text-error">{{ . }}</span>
          </div>
          {{ end }}
        </div>

        {{ template "password-validation" . }}

        <div class="flex flex-col gap-1">
          <label class="floating-label w-full">
            <input
              id="repeat_password"
              name="repeat_password"
              type="password"
              class="input w-full {{ with .Form.Errors.repeat_password }}input-error{{ end }}"
              placeholder="Repeat Password"
              autocomplete="new-password"
              {{ if .Form.Errors.repeat_password }}aria-describedby="repeat-password-error" aria-invalid="true"{{ end }}
            />
            <span>Repeat Password</span>
          </label>
          {{ with .Form.Errors.repeat_password }}
          <div class="label">
            <span id="repeat-password-error" class="label-text-alt text-error">{{ . }}</span>
          </div>
          {{ end }}
        </div>
      </div>

      <input type="hidden" name="website" />

      <button type="submit" class="btn btn-primary btn-block mt-4" data-loading-btn>
        <span class="size-4 rounded-full border-2 border-current border-t-transparent animate-spin hidden" data-loading-spinner></span>
        Register
      </button>

      <p class="label justify-center">
        Already have an account?
        <a href="/signin" class="link link-hover">Login</a>
      </p>
    </fieldset>
  </form>
</div>
{{ end }}
