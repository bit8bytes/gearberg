{{ define "page" }}
<div class="max-w-6xl mx-auto px-4 py-8 w-full">

  {{/* Stat cards */}}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">

    <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm p-5">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-semibold tracking-widest text-base-content/50 uppercase mb-1">Total Value</p>
          <p class="text-4xl font-bold">{{ .Data.TotalValue }}</p>
        </div>
        <span class="w-8 h-8">{{ template "pricing-icon" }}</span>
      </div>
    </div>

    <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm p-5">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-semibold tracking-widest text-base-content/50 uppercase mb-1">Total Stock</p>
          <a href="/orgs/{{ .Data.OrgID }}/equipment" class="text-4xl font-bold hover:underline">{{ .Data.TotalStock }}</a>
        </div>
        <span class="w-8 h-8">{{ template "equipment-icon" }}</span>
      </div>
    </div>

    <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm p-5">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-semibold tracking-widest text-error uppercase mb-1">Overdue Inspections</p>
          <a href="/orgs/{{ .Data.OrgID }}/equipment?inspection=overdue" class="text-4xl font-bold text-error hover:underline">{{ .Data.EquipmentOverdue }}</a>
        </div>
        <span class="w-8 h-8 text-error">{{ template "under-repair-icon" }}</span>
      </div>
    </div>

    <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm p-5">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-semibold tracking-widest text-warning uppercase mb-1">Inspections Due Within 30 Days</p>
          <a href="/orgs/{{ .Data.OrgID }}/equipment?inspection=due-30d" class="text-4xl font-bold text-warning hover:underline">{{ .Data.EquipmentOverdueSoon }}</a>
        </div>
        <span class="w-8 h-8 text-warning">{{ template "under-repair-icon" }}</span>
      </div>
    </div>

  </div>
</div>
{{ end }}
