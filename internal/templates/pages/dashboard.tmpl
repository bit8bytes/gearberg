{{ define "page" }}
<div class="max-w-6xl mx-auto px-4 py-8 w-full">

  {{/* Stat cards */}}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

    <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm p-5">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-semibold tracking-widest text-base-content/50 uppercase mb-1">Total Value</p>
          <p class="text-2xl font-bold">{{ .Data.TotalValue }}</p>
        </div>
        <span class="w-8 h-8">{{ template "pricing-icon" }}</span>
      </div>
    </div>

    <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm p-5">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-semibold tracking-widest text-base-content/50 uppercase mb-1">Total Stock</p>
          <p class="text-2xl font-bold">{{ .Data.TotalStock }}</p>
        </div>
        <span class="w-8 h-8">{{ template "equipment-icon" }}</span>
      </div>
    </div>

    <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm p-5">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-semibold tracking-widest text-error uppercase mb-1">Overdue Inspections</p>
          <p class="text-2xl font-bold text-error">{{ .Data.OverdueCount }}</p>
        </div>
        <span class="w-8 h-8 text-error">{{ template "overdue-inspections-icon" }}</span>
      </div>
    </div>

    <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm p-5">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-semibold tracking-widest text-warning uppercase mb-1">Due Within 30 Days</p>
          <p class="text-2xl font-bold text-warning">{{ .Data.SoonCount }}</p>
        </div>
        <span class="w-8 h-8 text-warning">{{ template "soon-inspections-icon" }}</span>
      </div>
    </div>

  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

  {{/* Overdue Inspections */}}
  <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm overflow-hidden">
    <div class="px-6 pt-6 pb-4 border-b border-base-300">
      <span class="text-xs font-semibold tracking-widest text-error uppercase mb-1">Action Required</span>
      <p class="text-2xl font-bold leading-tight">Inspections Overdue</p>
    </div>
    <div class="overflow-x-auto h-65 overflow-y-auto">
      <table class="table w-full">
        <thead class="bg-base-200 text-xs uppercase tracking-wide text-base-content/60 sticky top-0">
          <tr>
            <th>Item</th>
            <th class="text-right">Overdue</th>
          </tr>
        </thead>
        <tbody>
          {{ range .Data.OverdueInspections }}
          <tr>
            <td class="text-sm"><a href="/orgs/{{ $.Data.OrgID }}/equipment/{{ .EquipmentID }}/units" class="hover:underline">{{ .EquipmentName }}</a></td>
            <td class="text-right"><span class="badge badge-error badge-soft">{{ .DaysOverdue }} days</span></td>
          </tr>
          {{ else }}
          <tr>
            <td colspan="2" class="text-sm text-base-content/40 text-center py-6">No overdue inspections</td>
          </tr>
          {{ end }}
        </tbody>
      </table>
    </div>
    <div class="px-6 py-3 border-t border-base-300 flex justify-end">
      <a href="/orgs/{{ .Data.OrgID }}/equipment?inspection=overdue" class="btn btn-sm">See All <span class="w-4 h-4">{{ template "arrow-right-icon" }}</span></a>
    </div>
  </div>

  {{/* Soon Inspections */}}
  <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm overflow-hidden">
    <div class="px-6 pt-6 pb-4 border-b border-base-300">
      <span class="text-xs font-semibold tracking-widest text-warning uppercase mb-1">Upcoming</span>
      <p class="text-2xl font-bold leading-tight">Inspections Due Within 30 Days</p>
    </div>
    <div class="overflow-x-auto h-65 overflow-y-auto">
      <table class="table w-full">
        <thead class="bg-base-200 text-xs uppercase tracking-wide text-base-content/60 sticky top-0">
          <tr>
            <th>Item</th>
            <th class="text-right">Due In</th>
          </tr>
        </thead>
        <tbody>
          {{ range .Data.SoonInspections }}
          <tr>
            <td class="text-sm"><a href="/orgs/{{ $.Data.OrgID }}/equipment/{{ .EquipmentID }}/units" class="hover:underline">{{ .EquipmentName }}</a></td>
            <td class="text-right"><span class="badge badge-warning badge-soft">{{ .DaysUntil }} days</span></td>
          </tr>
          {{ else }}
          <tr>
            <td colspan="2" class="text-sm text-base-content/40 text-center py-6">No upcoming inspections</td>
          </tr>
          {{ end }}
        </tbody>
      </table>
    </div>
    <div class="px-6 py-3 border-t border-base-300 flex justify-end">
      <a href="/orgs/{{ .Data.OrgID }}/equipment?inspection=due-30d" class="btn btn-sm">See All <span class="w-4 h-4">{{ template "arrow-right-icon" }}</span></a>
    </div>
  </div>

  </div>
</div>
{{ end }}
