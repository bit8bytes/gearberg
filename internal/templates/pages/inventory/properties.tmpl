{{ define "title" }}{{ if .Data.Item }}{{ .Data.Item.Name }} — Properties{{ end }}{{ end }}

{{ define "page" }}
<div class="w-full bg-base-200 border-b border-base-300">
  <div class="max-w-5xl mx-auto px-4 h-24 flex items-center justify-between">
    <div>
      <h3>{{ .Data.Item.Name }}</h3>
      <p class="text-sm text-base-content/50 font-mono">#{{ .Data.Item.Code }}</p>
    </div>
  </div>
</div>

<div class="w-full bg-base-100 border-b border-base-200">
  <div class="max-w-5xl mx-auto px-4 h-14 flex items-center overflow-x-auto scrollbar-none">
    <div role="tablist" class="tabs tabs-border">
      <a href="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ID }}" role="tab" class="tab">Details</a>
      <a href="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ID }}/pricing" role="tab" class="tab">Pricing</a>
      <a href="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ID }}/properties" role="tab" class="tab tab-active">Properties</a>
      {{ if .Data.Item }}{{ if eq .Data.Item.Type 2 }}
      <a href="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ID }}/units" role="tab" class="tab">
        Units
        <span class="badge badge-sm ml-1">{{ .Data.Item.TotalStock }}</span>
      </a>
      {{ end }}{{ end }}
    </div>
  </div>
</div>

<div class="max-w-5xl w-full mx-auto px-4 my-8">  
  <form method="POST" class="flex flex-col gap-4" novalidate>

    <p class="text-sm font-medium text-base-content/50 uppercase tracking-wide">Physical</p>

    <div class="flex flex-col gap-1">
      <label for="weight_g">Weight <span class="text-base-content/40 text-xs">g</span></label>
      <input id="weight_g" type="number" name="weight_g" min="0" class="input"
        value="{{ if .Form.WeightG }}{{ .Form.WeightG }}{{ else if .Data.Item }}{{ .Data.Item.WeightGInput }}{{ end }}" />
    </div>

    <div class="flex flex-col gap-1 flex-1">
      <label for="width_mm">Width <span class="text-base-content/40 text-xs">mm</span></label>
      <input id="width_mm" type="number" name="width_mm" min="0" class="input"
        value="{{ if .Form.WidthMM }}{{ .Form.WidthMM }}{{ else if .Data.Item }}{{ .Data.Item.WidthMMInput }}{{ end }}" />
    </div>
    <div class="flex flex-col gap-1 flex-1">
      <label for="height_mm">Height <span class="text-base-content/40 text-xs">mm</span></label>
      <input id="height_mm" type="number" name="height_mm" min="0" class="input"
        value="{{ if .Form.HeightMM }}{{ .Form.HeightMM }}{{ else if .Data.Item }}{{ .Data.Item.HeightMMInput }}{{ end }}" />
    </div>
    <div class="flex flex-col gap-1 flex-1">
      <label for="depth_mm">Depth <span class="text-base-content/40 text-xs">mm</span></label>
      <input id="depth_mm" type="number" name="depth_mm" min="0" class="input"
        value="{{ if .Form.DepthMM }}{{ .Form.DepthMM }}{{ else if .Data.Item }}{{ .Data.Item.DepthMMInput }}{{ end }}" />
    </div>

    <p class="text-sm font-medium text-base-content/50 uppercase tracking-wide mt-2">Electrical</p>

    <div class="flex flex-col gap-1 flex-1">
      <label for="power_w">Power <span class="text-base-content/40 text-xs">W</span></label>
      <input id="power_w" type="text" inputmode="decimal" name="power_w" class="input"
        value="{{ if .Form.PowerW }}{{ .Form.PowerW }}{{ else if .Data.Item }}{{ .Data.Item.PowerWattsInput }}{{ end }}" />
    </div>
    <div class="flex flex-col gap-1 flex-1">
      <label for="current_a">Current <span class="text-base-content/40 text-xs">A</span></label>
      <input id="current_a" type="text" inputmode="decimal" name="current_a" class="input"
        value="{{ if .Form.CurrentA }}{{ .Form.CurrentA }}{{ else if .Data.Item }}{{ .Data.Item.CurrentAmpsInput }}{{ end }}" />
    </div>

    <div>
      <button type="submit" formaction="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ID }}/properties" class="btn btn-primary" data-loading-trigger>
        {{ template "loading-spinner" . }}
        Save
      </button>
    </div>

  </form>

</div>
{{ end }}
