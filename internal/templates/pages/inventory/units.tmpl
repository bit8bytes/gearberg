{{ define "title" }}{{ .Data.ItemName }} — Units{{ end }}

{{ define "page" }}
<div class="w-full bg-base-200 border-b border-base-300">
  <div class="max-w-5xl mx-auto px-4 h-24 flex items-center justify-between">
    <div>
      <h3>{{ .Data.Item.Name }}</h3>
      <p class="text-sm text-base-content/50 font-mono">#{{ .Data.ItemCode }}</p>
    </div>
  </div>
</div>

<div class="w-full bg-base-100 border-b border-base-200">
  <div class="max-w-5xl mx-auto px-4 min-h-14 flex items-center overflow-x-auto scrollbar-none">
    <div role="tablist" class="tabs tabs-border">
      <a href="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ItemID }}" role="tab" class="tab">Details</a>
      <a href="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ItemID }}/pricing" role="tab" class="tab">Pricing</a>
      <a href="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ItemID }}/properties" role="tab" class="tab">Properties</a>
      <a href="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ItemID }}/units" role="tab" class="tab tab-active">
        Units
        <span class="badge badge-sm ml-1">{{ len .Data.Units }}</span>
      </a>
      <a href="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ItemID }}/inspection" role="tab" class="tab">Inspection</a>
    </div>
  </div>
</div>

<div class="max-w-5xl w-full mx-auto mb-16">

  {{/* Delete forms live outside the table to avoid nesting. */}}
  {{ range .Data.Units }}
  <form id="unit-{{ .ID }}-delete" method="POST" action="/orgs/{{ $.Data.OrgID }}/inventory/{{ $.Data.ItemID }}/units/{{ .ID }}/delete"></form>
  {{ end }}

  {{ if .Data.Units }}
  <div class="overflow-x-auto">
    <table class="table w-full mb-24">
      <thead>
        <tr>
          <th class="w-10">#</th>
          <th>STATUS</th>
          <th>SERIAL NUMBER</th>
          <th>NOTES</th>
          {{ if $.Data.Item.InspectionIntervalDays }}
          <th>LAST INSPECTION</th>
          <th>NEXT INSPECTION</th>
          {{ end }}
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{ range .Data.Units }}
        {{ $currentStatusID := .StatusID }}
        {{ $unitInspections := index $.Data.Inspections .ID }}
        <tr>
          <td class="whitespace-nowrap">
            <span class="badge badge-ghost font-mono text-xs">{{ $.Data.ItemCode }}-{{ .UnitNumber }}</span>
          </td>
          <td>
            <div class="flex items-center gap-1.5">
              {{ if eq .StatusID 1 }}<span class="w-4 h-4 text-success shrink-0">{{ template "available-icon" . }}</span>
              {{ else if eq .StatusID 2 }}<span class="w-4 h-4 text-error shrink-0">{{ template "damaged-icon" . }}</span>
              {{ else if eq .StatusID 3 }}<span class="w-4 h-4 text-warning shrink-0">{{ template "under-repair-icon" . }}</span>
              {{ else if eq .StatusID 4 }}<span class="w-4 h-4 text-base-content/40 shrink-0">{{ template "retired-icon" . }}</span>
              {{ else if eq .StatusID 5 }}<span class="w-4 h-4 text-info shrink-0">{{ template "inhouse-icon" . }}</span>
              {{ end }}
              <span class="text-sm">{{ range $.Data.UnitStatuses }}{{ if eq .ID $currentStatusID }}{{ .Label }}{{ end }}{{ end }}</span>
            </div>
          </td>
          <td class="text-sm">{{ if .SerialNumber }}{{ .SerialNumber }}{{ else }}<span class="text-base-content/30">—</span>{{ end }}</td>
          <td class="text-sm">{{ if .Notes }}{{ .Notes }}{{ else }}<span class="text-base-content/30">—</span>{{ end }}</td>
          {{ if $.Data.Item.InspectionIntervalDays }}
          <td class="text-sm">
            {{ if $unitInspections }}
              <div class="flex items-center gap-1.5">
                {{ if (index $unitInspections 0).Passed }}
                  <span 
                    class="badge badge-success badge-soft badge-sm tooltip" 
                    data-tip=" {{ (index $unitInspections 0).InspectedAtDisplay }}">
                      Passed
                  </span>
                {{ else }}
                  <span 
                    class="badge badge-error badge-soft badge-sm tooltip" 
                    data-tip=" {{ (index $unitInspections 0).InspectedAtDisplay }}">
                    Failed
                  </span>
                {{ end }}
               
              </div>
            {{ else }}
              <span class="text-base-content/30">—</span>
            {{ end }}
          </td>
          <td class="text-sm">
            {{ $nextDays := .NextInspectionInDays $.Data.Item.InspectionIntervalDays }}
            {{ if $nextDays }}
              {{ if .IsInspectionOverdue $.Data.Item.InspectionIntervalDays }}
                <span class="text-error font-medium">{{ $nextDays }}</span>
              {{ else if eq $nextDays "Today" }}
                <span class="text-warning font-medium">Today</span>
              {{ else }}
                {{ $nextDays }}
              {{ end }}
            {{ else }}
              <span class="text-base-content/30">—</span>
            {{ end }}
          </td>
          {{ end }}
          <td class="text-right">
            <div class="flex gap-1 justify-end">
              <button data-modal-target="unit-modal-{{ .ID }}" class="btn btn-sm btn-ghost">Edit</button>
              <details class="dropdown dropdown-end">
                <summary class="btn btn-sm btn-ghost btn-square">
                  <span class="w-4 h-4">{{ template "dot-menu-icon" . }}</span>
                </summary>
                <ul class="dropdown-content menu bg-base-100 rounded-box z-1 w-52 p-1 shadow border border-base-300">
                  {{ if $.Data.Item.InspectionIntervalDays }}
                  <li>
                    <button data-modal-target="log-inspection-modal-{{ .ID }}">
                      <span class="w-4 h-4">{{ template "log-inspection-icon" . }}</span>
                      Add Inspection
                    </button>
                  </li>
                  {{ end }}
                  <li>
                    <a href="/orgs/{{ $.Data.OrgID }}/inventory/{{ $.Data.ItemID }}/units/{{ .ID }}/qr">
                      <span class="w-4 h-4">{{ template "qr-icon" . }}</span>
                      Download QR
                    </a>
                  </li>
                  <li>
                    <button
                      form="unit-{{ .ID }}-delete"
                      type="submit"
                      class="text-error"
                      data-confirm="Delete unit {{ $.Data.ItemCode }}-{{ .UnitNumber }}?"
                    >
                    <span class="w-4 h-4">{{ template "delete-icon" . }}</span>
                    Delete</button>
                  </li>
                </ul>
              </details>
            </div>
          </td>
        </tr>
        {{ end }}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="7" class="text-right pt-2 px-4">
            <form method="POST" action="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ItemID }}/units">
              <button type="submit" class="btn btn-sm btn-primary">Add unit</button>
            </form>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
  {{ else }}
  <div class="flex flex-col items-center gap-3 py-16 text-base-content/40">
    <p class="text-sm">No units recorded.
      <form class="inline" method="POST" action="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ItemID }}/units">
        <button type="submit" class="link">Add the first unit.</button>
      </form>
    </p>
  </div>
  {{ end }}

  {{/* Add Inspection modals — one per unit, only when interval is configured */}}
  {{ if .Data.Item.InspectionIntervalDays }}
  {{ range .Data.Units }}
  {{ $unitInspections := index $.Data.Inspections .ID }}
  <dialog id="log-inspection-modal-{{ .ID }}" class="modal">
    <div class="modal-box max-w-md flex flex-col gap-4">
      <h3 class="font-semibold">Add Inspection — {{ $.Data.ItemCode }}-{{ .UnitNumber }}</h3>

      <form id="log-entry-{{ .ID }}" method="POST" action="/orgs/{{ $.Data.OrgID }}/inventory/{{ $.Data.ItemID }}/units/{{ .ID }}/inspections" class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
          <label>Date</label>
          <input 
            type="date" 
            name="inspected_at" 
            value="{{ $.Data.Today }}" 
            max="{{ $.Data.Today }}"
            class="input w-full" />
        </div>

        <div class="flex flex-col gap-1">
          <label>Result</label>
          <select name="passed" class="select w-full">
            <option value="1">Passed</option>
            <option value="0">Failed</option>
          </select>
        </div>

        <div class="flex flex-col gap-1">
          <label>Notes <span class="text-base-content/40 text-xs">(optional)</span></label>
          <textarea name="notes" maxlength="1000" class="textarea w-full" placeholder="—"></textarea>
        </div>
      </form>

      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-ghost">Cancel</button>
        </form>
        <button type="submit" form="log-entry-{{ .ID }}" class="btn btn-primary" data-loading-trigger>
          {{ template "loading-spinner" . }}
          Log
        </button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>
  {{ end }}
  {{ end }}

  {{/* Unit edit modals — one per unit */}}
  {{ range .Data.Units }}
  <dialog id="unit-modal-{{ .ID }}" class="modal">
    <div class="modal-box max-w-md flex flex-col gap-4">
      <h3 class="font-semibold">Unit {{ $.Data.ItemCode }}-{{ .UnitNumber }}</h3>

      <form id="unit-edit-{{ .ID }}" method="POST" action="/orgs/{{ $.Data.OrgID }}/inventory/{{ $.Data.ItemID }}/units/{{ .ID }}" class="flex flex-col gap-4">
        <div class="flexflex-col gap-1">
          <label>Status</label>
          {{ $currentStatusID := .StatusID }}
          <select name="status_id" class="select w-full">
            {{ range $.Data.UnitStatuses }}
            <option value="{{ .ID }}"{{ if eq .ID $currentStatusID }} selected{{ end }}>{{ .Label }}</option>
            {{ end }}
          </select>
        </div>

        <div class="flex flex-col gap-1">
          <label>Manufacturer Serial Number <span class="text-base-content/40 text-xs">(optional)</span></label>
          <input type="text" name="serial_number" value="{{ .SerialNumber }}" maxlength="200" class="input w-full" placeholder="-" />
        </div>

        <div class="flex flex-col gap-1">
          <label>Notes <span class="text-base-content/40 text-xs">(optional)</span></label>
          <textarea name="notes" maxlength="1000" class="textarea w-full" placeholder="—">{{ .Notes }}</textarea>
        </div>

        <div class="flex flex-col gap-1">
          <label>Purchase Date <span class="text-base-content/40 text-xs">(optional)</span></label>
          <input 
            type="date" 
            name="purchased_at" 
            value="{{ .PurchasedAtInput }}" 
            max="{{ $.Data.Today }}"
            class="input w-full" />
          <span class="text-base-content/40 text-xs">Used to calculate the first inspection date.</span>
        </div>
      </form>

      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-ghost">Cancel</button>
        </form>
        <button type="submit" form="unit-edit-{{ .ID }}" class="btn btn-primary" data-loading-trigger>
          {{ template "loading-spinner" . }}
          Save
        </button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>
  {{ end }}

</div>

{{ end }}
