{{ define "title" }}{{ if .Data.Item }}{{ .Data.Item.Name }}{{ end }}{{ end }}

{{ define "page" }}
<div class="flex-1 max-w-lg mx-auto my-8">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1>Edit</h1>
      {{ if .Data.Item }}
      <span class="badge badge-ghost badge-sm">Serialized</span>
      {{ end }}
    </div>
    <a href="/orgs/{{ .Data.OrgID }}/inventory" class="btn">Back</a>
  </div>

  <form method="POST" enctype="multipart/form-data" class="flex flex-col gap-4" novalidate>

    <div class="flex flex-col gap-1">
      <label>Photo</label>
      <label for="image" class="cursor-pointer w-24 h-24 rounded-lg border-2 border-dashed border-base-300 bg-base-200 flex items-center justify-center overflow-hidden" data-image-preview>
        {{ if and .Data.Item .Data.Item.ImageURL }}
        <img class="w-full h-full object-cover" src="{{ .Data.Item.ImageURL }}" data-image-preview-img alt="{{ .Data.Item.Name }}" />
        {{ else }}
        {{ template "camera-icon" . }}
        <img class="hidden w-full h-full object-cover" data-image-preview-img alt="Preview" />
        {{ end }}
      </label>
      <input id="image" type="file" name="image" accept="image/jpeg,image/png" class="hidden" data-image-input />
    </div>

    <div class="flex flex-col gap-1">
      <label for="name">Name</label>
      <input
        id="name"
        type="text"
        name="name"
        value="{{ if .Form.Name }}{{ .Form.Name }}{{ else if .Data.Item }}{{ .Data.Item.Name }}{{ end }}"
        maxlength="200"
        class="input w-full"
      />
      {{ with index .Form.Errors "name" }}
        <p class="text-red-500 text-sm">{{ . }}</p>
      {{ end }}
    </div>

    <div class="flex flex-col gap-1">
      <label for="category_id">Category</label>
      <select id="category_id" name="category_id" class="select w-full">
        <option value="">Select a category</option>
        {{ range .Data.Categories }}
          <option value="{{ .ID }}"
            {{ if $.Form.CategoryID }}
              {{ if eq $.Form.CategoryID .ID }}selected{{ end }}
            {{ else if $.Data.Item }}
              {{ if eq $.Data.Item.CategoryID .ID }}selected{{ end }}
            {{ end }}
          >{{ .Name }}</option>
        {{ end }}
      </select>
      {{ with index .Form.Errors "category_id" }}
        <p class="text-red-500 text-sm">{{ . }}</p>
      {{ end }}
    </div>

    <div class="flex flex-col gap-1">
      <label for="manufacturer_id">Manufacturer</label>
      <select id="manufacturer_id" name="manufacturer_id" class="select w-full" {{ if not .Data.Manufacturers }}disabled{{ end }}>
        <option value="">None</option>
        {{ range .Data.Manufacturers }}
          <option value="{{ .ID }}"
            {{ if $.Form.ManufacturerID }}
              {{ if eq $.Form.ManufacturerID .ID }}selected{{ end }}
            {{ else if $.Data.Item }}
              {{ if eq $.Data.Item.ManufacturerID .ID }}selected{{ end }}
            {{ end }}
          >{{ .Name }}</option>
        {{ end }}
      </select>
    </div>

    <div class="flex flex-col gap-1">
      <label for="code">Code</label>
      <input
        id="code"
        type="number"
        name="code"
        min="1"
        value="{{ if .Form.Code }}{{ .Form.Code }}{{ else if .Data.Item }}{{ .Data.Item.Code }}{{ end }}"
        class="input w-full"
        readonly
      />
      <p class="text-xs text-base-content/50">Auto-generated by the system.</p>
      {{ with index .Form.Errors "code" }}
        <p class="text-red-500 text-sm">{{ . }}</p>
      {{ end }}
    </div>

    <div class="flex gap-2">
      <div class="flex flex-col gap-1 flex-1">
        <label for="purchase_price">Purchase Price <span class="text-base-content/40 text-xs">(optional)</span></label>
        <label class="input w-full">
          {{ if .Data.Currency }}<span class="opacity-50">{{ .Data.Currency }}</span>{{ end }}
          <input
            id="purchase_price"
            type="text"
            inputmode="decimal"
            name="purchase_price"
            value="{{ if .Form.PurchasePrice }}{{ .Form.PurchasePrice }}{{ else if .Data.Item }}{{ .Data.Item.PurchasePriceInput }}{{ end }}"
          />
        </label>
        {{ with index .Form.Errors "purchase_price" }}
          <p class="text-red-500 text-sm">{{ . }}</p>
        {{ end }}
      </div>
      <div class="flex flex-col gap-1 flex-1">
        <label for="rental_price">Rental Price <span class="text-base-content/40 text-xs">(optional)</span></label>
        <label class="input w-full">
          {{ if .Data.Currency }}<span class="opacity-50">{{ .Data.Currency }}</span>{{ end }}
          <input
            id="rental_price"
            type="text"
            inputmode="decimal"
            name="rental_price"
            value="{{ if .Form.RentalPrice }}{{ .Form.RentalPrice }}{{ else if .Data.Item }}{{ .Data.Item.RentalPriceInput }}{{ end }}"
          />
        </label>
        {{ with index .Form.Errors "rental_price" }}
          <p class="text-red-500 text-sm">{{ . }}</p>
        {{ end }}
      </div>
    </div>

    <div class="flex flex-col gap-1">
      <label for="notes">Notes <span class="text-base-content/40 text-xs">(optional)</span></label>
      <textarea id="notes" name="notes" class="textarea w-full" rows="3">{{ if .Form.Notes }}{{ .Form.Notes }}{{ else if .Data.Item }}{{ .Data.Item.Notes }}{{ end }}</textarea>
    </div>

    <details class="border-2 border-base-300 rounded-lg">
      <summary class="cursor-pointer px-4 py-3 font-medium select-none">Properties</summary>
      <div class="flex flex-col gap-4 px-4 pb-4 pt-2">

        <div class="flex flex-col gap-1">
          <label for="weight_g">Weight <span class="text-base-content/40 text-xs">g</span></label>
          <input id="weight_g" type="number" name="weight_g" min="0" class="input w-full"
            value="{{ if .Form.WeightG }}{{ .Form.WeightG }}{{ else if .Data.Item }}{{ .Data.Item.WeightGInput }}{{ end }}" />
        </div>

        <div class="flex gap-2">
          <div class="flex flex-col gap-1 flex-1">
            <label for="width_mm">Width <span class="text-base-content/40 text-xs">mm</span></label>
            <input id="width_mm" type="number" name="width_mm" min="0" class="input w-full"
              value="{{ if .Form.WidthMM }}{{ .Form.WidthMM }}{{ else if .Data.Item }}{{ .Data.Item.WidthMMInput }}{{ end }}" />
          </div>
          <div class="flex flex-col gap-1 flex-1">
            <label for="height_mm">Height <span class="text-base-content/40 text-xs">mm</span></label>
            <input id="height_mm" type="number" name="height_mm" min="0" class="input w-full"
              value="{{ if .Form.HeightMM }}{{ .Form.HeightMM }}{{ else if .Data.Item }}{{ .Data.Item.HeightMMInput }}{{ end }}" />
          </div>
          <div class="flex flex-col gap-1 flex-1">
            <label for="depth_mm">Depth <span class="text-base-content/40 text-xs">mm</span></label>
            <input id="depth_mm" type="number" name="depth_mm" min="0" class="input w-full"
              value="{{ if .Form.DepthMM }}{{ .Form.DepthMM }}{{ else if .Data.Item }}{{ .Data.Item.DepthMMInput }}{{ end }}" />
          </div>
        </div>

        <div class="flex gap-2">
          <div class="flex flex-col gap-1 flex-1">
            <label for="power_w">Power <span class="text-base-content/40 text-xs">W</span></label>
            <input id="power_w" type="text" inputmode="decimal" name="power_w" class="input w-full"
              value="{{ if .Form.PowerW }}{{ .Form.PowerW }}{{ else if .Data.Item }}{{ .Data.Item.PowerWattsInput }}{{ end }}" />
          </div>
          <div class="flex flex-col gap-1 flex-1">
            <label for="current_a">Current <span class="text-base-content/40 text-xs">A</span></label>
            <input id="current_a" type="text" inputmode="decimal" name="current_a" class="input w-full"
              value="{{ if .Form.CurrentA }}{{ .Form.CurrentA }}{{ else if .Data.Item }}{{ .Data.Item.CurrentAmpsInput }}{{ end }}" />
          </div>
        </div>

      </div>
    </details>

    <div class="flex gap-2">
      <button type="submit" formaction="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ID }}/serialized" class="btn btn-primary" data-loading-trigger>
        {{ template "loading-spinner" . }}
        Save
      </button>
      <a href="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ID }}/units" class="btn btn-outline">
        Units
        {{ if .Data.Item }}<span class="badge badge-sm">{{ .Data.Item.TotalStock }}</span>{{ end }}
      </a>
      <button data-confirm="Delete inventory item?" formaction="/orgs/{{ .Data.OrgID }}/inventory/{{ .Data.ID }}/delete" type="submit" class="btn btn-error btn-outline">Delete</button>
    </div>

  </form>


</div>
{{ end }}
