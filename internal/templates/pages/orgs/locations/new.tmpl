{{ define "title" }}New Location{{ end }}

{{ define "page" }}
<div class="flex-1 max-w-xs mx-auto mt-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="">New Location</h1>
    <a href="/orgs/{{ .Data.OrgID }}/settings/locations" class="btn">Back</a>
  </div>

  <form method="POST" action="/orgs/{{ .Data.OrgID }}/settings/locations/new" class="flex flex-col gap-4" novalidate>
    <div class="flex flex-col gap-1">
      <label for="name">Name</label>
      <input
        id="name"
        type="text"
        name="name"
        value="{{ .Form.Name }}"
        maxlength="100"
        class="input"
      />
      {{ with index .Form.Errors "name" }}
        <p class="text-red-500 text-sm">{{ . }}</p>
      {{ end }}
    </div>

    <div class="flex gap-2">
      <button type="submit" class="btn btn-primary">Create</button>
      <a href="/orgs/{{ .Data.OrgID }}/settings/locations" class="btn">Cancel</a>
    </div>
  </form>
</div>
{{ end }}
