{{define "page"}}
<div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm overflow-hidden">

  <div class="px-6 pt-6 pb-4 border-b border-base-300">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-semibold tracking-widest text-primary uppercase mb-1">Settings</p>
        <p class="text-3xl font-bold leading-tight">Organizations</p>
      </div>
      <div class="shrink-0 pt-1">
        {{ if ge (len .Data.Orgs) .Data.Max }}
        <div class="tooltip tooltip-left" data-tip="Maximum of {{ .Data.Max }} orgs reached">
          <button class="btn btn-primary" disabled>+ New</button>
        </div>
        {{ else }}
        <a href="/orgs/new" class="btn btn-primary">+ New</a>
        {{ end }}
      </div>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="table w-full">
      <thead class="bg-base-200 text-xs uppercase tracking-wide text-base-content/60">
        <tr>
          <th>Name</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{ with .Data.Orgs }}
        {{ range . }}
        <tr class="hover:bg-base-200/50">
          <td>
            <a href="/orgs/{{ .ID }}/equipment" class="flex items-center gap-3 font-medium">
              <span class="size-4">{{ template "orgs-icon" . }}</span>
              {{ .DisplayName }}
            </a>
          </td>
          <td class="text-right">
            <a 
              href="/orgs/{{ .ID }}/equipment" 
              class="btn btn-ghost btn-sm btn-square tooltip tooltip-left" 
              data-tip="Go to dashboard">
              <span class="size-4">{{ template "arrow-right-icon" . }}</span>
            </a>
            <a href="/orgs/{{ .ID }}/settings" 
              class="btn btn-ghost btn-sm btn-square tooltip tooltip-left" 
              data-tip="Organization settings">
              <span class="size-4">{{ template "settings-icon" . }}</span>
            </a>
          </td>
        </tr>
        {{ end }}
        {{ else }}
        <tr>
          <td colspan="2">
            <div class="flex flex-col items-center gap-3 py-16 text-base-content/40">
              <span class="size-4">{{ template "orgs-icon" . }}</span>
              <p class="text-sm">No orgs yet.</p>
            </div>
          </td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>

</div>
{{end}}
