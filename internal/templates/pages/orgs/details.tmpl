{{ define "title" }}General{{ end }}

{{ define "page" }}
<div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm overflow-hidden">

  <div class="px-6 pt-6 pb-4 border-b border-base-300">
    <p class="text-xs font-semibold tracking-widest text-primary uppercase mb-1">Settings</p>
    <p class="text-3xl font-bold leading-tight">General</p>
  </div>

  <div class="px-6 py-6 max-w-xl">
  <p class="text-sm text-neutral mb-6">Org name and basic information.</p>

  <form method="POST" action="/orgs/{{ .Data.OrgID }}" class="flex flex-col gap-4" novalidate>
    <div class="flex flex-col gap-1">
      <label for="name">Name</label>
      <input
        id="name"
        type="text"
        name="name"
        value="{{ .Form.DisplayName }}"
        maxlength="100"
        class="input"
      />
      {{ with index .Form.Errors "name" }}
        <p class="text-red-500 text-sm">{{ . }}</p>
      {{ end }}
    </div>

    <div>
      <button type="submit" class="btn btn-primary">Save</button>
    </div>
  </form>

  <div class="mt-10 border-t pt-6">
    <h3 class="mb-1">Storage</h3>
    <p class="text-sm text-neutral mb-4">{{ .Data.StorageUsage.Used }} of {{ .Data.StorageUsage.Max }} used</p>
    <progress class="progress w-full" value="{{ .Data.StorageUsage.Percent }}" max="100"></progress>
  </div>

  <div class="mt-10 border-t border-error pt-6">
    <h3 class="mb-1 text-error">Danger Zone</h3>
    <p class="text-sm text-neutral mb-4">Permanently delete this org and all associated data.</p>
    <button data-modal-target="delete_org_modal" class="btn btn-error">Delete Org</button>
  </div>
  </div>{{/* end px-6 py-6 */}}
</div>{{/* end card */}}

<dialog id="delete_org_modal" class="modal">
  <div class="modal-box">
    <h3>Delete Org</h3>
    <p class="py-4">Are you sure you want to permanently delete this org and all associated data? This action cannot be undone.</p>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn">Cancel</button>
      </form>
      <button class="btn btn-error"
              hx-delete="/orgs/{{ .Data.OrgID }}"
              hx-push-url="true">Delete</button>
    </div>
  </div>
</dialog>
{{ end }}
