{{ define "title" }}Add Item{{ end }}

{{ define "page" }}
<div class="max-w-3xl mx-auto px-4 pt-6 w-full mt-16">

  <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm overflow-hidden">

    {{/* Header block */}}
    <div class="flex flex-col gap-2 px-6 pt-6 pb-4 border-b border-base-300">
      <a href="/orgs/{{ .Data.OrgID }}/equipment" class="btn btn-sm w-fit">← Back</a>
      <div>
        <p class="text-3xl font-bold leading-tight">Add Item</p>
        <p class="text-sm text-base-content/80">Create a new piece of gear for your inventory.</p>
      </div>
    </div>

    <form 
      method="POST" 
      action="/orgs/{{ .Data.OrgID }}/equipment/new" 
      enctype="multipart/form-data" 
      novalidate
      class="flex flex-col gap-8 p-6">

      <input type="hidden" name="usage_type_id" value="rental" />
      <div>
        <div class="flex gap-2 border-dashed border-b border-base-300 pb-1 mb-4 items-center">
          <span class="text-base-content/60 border border-base-300 bg-base-200 rounded-full w-6 h-6 flex items-center justify-center text-xs">1</span>
          <p class="text-sm tracking-wider uppercase font-medium text-base-content/60">Details</p>
        </div>
        
        <div class="flex flex-col gap-2">

          {{ template "photo-picker" . }}

          <div class="grid grid-cols-1 md:grid-cols-4 gap-2">

            <div class="flex flex-col gap-1 md:col-span-2">
              <label for="name" class="label">Name</label>
              <input id="name" type="text" name="equipment_name" value="{{ .Form.Name }}" maxlength="200" class="input w-full" autofocus />
              {{ with index .Form.Errors "name" }}
                <p class="text-error text-sm">{{ . }}</p>
              {{ end }}
            </div>

            <div class="flex flex-col gap-1 md:col-span-2">
              <label for="category_input" class="label">Category <span class="text-base-content/40 text-xs">(optional)</span></label>
              <div
                hx-get="/orgs/{{ .Data.OrgID }}/equipment-categories{{ if .Form.CategoryID }}?selected={{ .Form.CategoryID }}{{ else if .Form.CategoryName }}?selected_name={{ .Form.CategoryName | urlquery }}{{ end }}"
                hx-trigger="load"
                hx-swap="outerHTML">
                {{ template "equipment-categories-skeleton" . }}
              </div>
              {{ with index .Form.Errors "category_id" }}
                <p class="text-error text-sm">{{ . }}</p>
              {{ end }}
            </div>

            <div class="flex flex-col gap-1 md:col-span-2">
              <label for="manufacturer_input" class="label">Manufacturer <span class="text-base-content/40 text-xs">(optional)</span></label>
              <div
                hx-get="/orgs/{{ .Data.OrgID }}/equipment-manufacturers{{ if .Form.ManufacturerID }}?selected={{ .Form.ManufacturerID }}{{ else if .Form.ManufacturerName }}?selected_name={{ .Form.ManufacturerName | urlquery }}{{ end }}"
                hx-trigger="load"
                hx-swap="outerHTML">
                {{ template "equipment-manufacturers-skeleton" . }}
              </div>
            </div>

            <div class="flex flex-col gap-1 md:col-span-2">
              <label for="location_input" class="label">Location <span class="text-base-content/40 text-xs">(optional)</span></label>
              <div
                hx-get="/orgs/{{ .Data.OrgID }}/warehouse-locations{{ if .Form.LocationID }}?selected={{ .Form.LocationID }}{{ else if .Form.LocationName }}?selected_name={{ .Form.LocationName | urlquery }}{{ end }}"
                hx-trigger="load"
                hx-swap="outerHTML">
                {{ template "warehouse-locations-skeleton" . }}
              </div>
            </div>

          </div>

        </div>
      </div>

      <div>
        <div class="flex gap-2 border-dashed border-b border-base-300 pb-1 mb-4 items-center">
          <span class="text-base-content/60 border border-base-300 bg-base-200 rounded-full w-6 h-6 flex items-center justify-center text-xs">2</span>
          <p class="text-sm tracking-wider uppercase font-medium text-base-content/60">Tracking</p>
        </div>

        <div class="flex flex-col gap-1">
          <div class="grid grid-cols-3 gap-3" data-type-selector>
            <label data-type-option class="cursor-pointer flex flex-col gap-1 rounded-lg border-2 p-3 transition-colors focus-within:ring-2 focus-within:ring-primary focus-within:ring-offset-2 {{ if or (eq .Form.ItemType "") (eq .Form.ItemType "bulk") }}border-primary bg-primary/10{{ else }}border-base-300 bg-base-200{{ end }}">
              <input
                type="radio"
                name="type_id"
                value="bulk"
                class="sr-only"
                tabindex="0"
                {{ if or (eq .Form.ItemType "") (eq .Form.ItemType "bulk") }}checked{{ end }}
              />
              <div class="w-5 h-5">{{ template "bulk-icon" . }}</div>
              <span class="font-medium text-sm">Bulk</span>
              <span class="text-xs text-base-content/50">Track a total quantity</span>
            </label>
            <label data-type-option class="cursor-pointer flex flex-col gap-1 rounded-lg border-2 p-3 transition-colors focus-within:ring-2 focus-within:ring-primary focus-within:ring-offset-2 {{ if eq .Form.ItemType "serialized" }}border-primary bg-primary/10{{ else }}border-base-300 bg-base-200{{ end }}">
              <input
                type="radio"
                name="type_id"
                value="serialized"
                class="sr-only"
                {{ if eq .Form.ItemType "serialized" }}checked{{ end }}
              />
              <div class="w-5 h-5">{{ template "serialized-icon" . }}</div>
              <span class="font-medium text-sm">Serialized</span>
              <span class="text-xs text-base-content/50">Track individual units with serial numbers</span>
            </label>
            <label data-type-option class="cursor-pointer flex flex-col gap-1 rounded-lg border-2 p-3 transition-colors focus-within:ring-2 focus-within:ring-primary focus-within:ring-offset-2 {{ if eq .Form.ItemType "kit" }}border-primary bg-primary/10{{ else }}border-base-300 bg-base-200{{ end }}">
              <input
                type="radio"
                name="type_id"
                value="kit"
                class="sr-only"
                {{ if eq .Form.ItemType "kit" }}checked{{ end }}
              />
              <div class="w-5 h-5">{{ template "kit-icon" . }}</div>
              <span class="font-medium text-sm">Kit</span>
              <span class="text-xs text-base-content/50">Serialized units that contain other items</span>
            </label>
          </div>
          {{ with index .Form.Errors "type_id" }}
            <p class="text-error text-sm">{{ . }}</p>
          {{ end }}

          <div class="flex flex-col gap-1">
            <label for="count" class="label">Quantity</label>
            <input
              id="count"
              type="number"
              name="count"
              value="{{ if .Form.Count }}{{ .Form.Count }}{{ else }}1{{ end }}"
              min="1"
              class="input w-full"
            />
            {{ with index .Form.Errors "count" }}
              <p class="text-error text-sm">{{ . }}</p>
            {{ end }}
          </div>
        </div>

      </div>

      <div>
        <div class="flex gap-2 border-dashed border-b border-base-300 pb-1 mb-4 items-center">
          <span class="text-base-content/60 border border-base-300 bg-base-200 rounded-full w-6 h-6 flex items-center justify-center text-xs">3</span>
          <p class="text-sm tracking-wider uppercase font-medium text-base-content/60">Pricing</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
          <div class="flex flex-col gap-1">
            <label for="purchase_price" class="label">Purchase Price <span class="text-base-content/40 text-xs">(optional)</span></label>
            <label class="input w-full">
              <span hx-get="/orgs/{{ .Data.OrgID }}/currency" hx-trigger="load" hx-swap="outerHTML">{{ template "org-currency-skeleton" . }}</span>
              <input id="purchase_price" type="number" inputmode="decimal" step="0.01" min="0" name="purchase_price" value="{{ .Form.PurchasePrice }}" />
            </label>
            {{ with index .Form.Errors "purchase_price" }}
              <p class="text-error text-sm">{{ . }}</p>
            {{ end }}
          </div>

          <div class="flex flex-col gap-1">
            <label for="rental_price" class="label">Rental Price <span class="text-base-content/40 text-xs">(optional)</span></label>
            <label class="input w-full">
              <span hx-get="/orgs/{{ .Data.OrgID }}/currency" hx-trigger="load" hx-swap="outerHTML">{{ template "org-currency-skeleton" . }}</span>
              <input id="rental_price" type="number" inputmode="decimal" step="0.01" min="0" name="rental_price" value="{{ .Form.RentalPrice }}" />
            </label>
            {{ with index .Form.Errors "rental_price" }}
              <p class="text-error text-sm">{{ . }}</p>
            {{ end }}
          </div>
        </div>
      </div>


      <div class="flex flex-col gap-4">

        <div class="flex gap-2">
          <button type="submit" tabindex="0" class="btn btn-primary" data-loading-trigger>
            {{ template "loading-spinner" . }}
            Add Item
          </button>
          <a tabindex="0" href="/orgs/{{ .Data.OrgID }}/equipment" class="btn">Cancel</a>
        </div>

      </div>
    </form>

  </div>{{/* end card */}}
</div>
{{ template "photo-picker-dialog" . }}
{{ end }}
