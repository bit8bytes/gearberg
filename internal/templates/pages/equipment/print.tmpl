{{ define "title" }}Equipment – Print{{ end }}

{{ define "page" }}
<div class="print-page">
  <div class="print-header">
    <div class="print-header-left">
      <h1>Equipment List</h1>
      <div class="meta">
        <span>{{ .Data.OrgDisplayName }}</span>
        <span>{{ .Data.PrintDate }}</span>
        <span>{{ .Data.TotalCount }} items</span>
        {{ if .Data.Query }}<span>Search: "{{ .Data.Query }}"</span>{{ end }}
        {{ if .Data.Category }}<span>{{ .Data.Category }}</span>{{ end }}
        {{ if .Data.Currency }}<span>{{ .Data.Currency }}</span>{{ end }}
        {{ if .Data.VatRate }}<span>VAT {{ .Data.VatRate.Display }}</span>{{ end }}
      </div>
    </div>
    <div class="print-logo">
      {{ template "logo" . }}
      <span class="print-logo-sub">by bit8bytes</span>
    </div>
  </div>

  {{ if .Data.Inventories }}
  <table class="print-table">
    <thead>
      <tr>
        <th class="print-img-cell"></th>
        <th>Name</th>
        <th>Category</th>
        <th class="print-col-stock">Stock</th>
        <th class="print-col-price">Rental Price</th>
      </tr>
    </thead>
    <tbody>
      {{ range .Data.Inventories }}
      <tr>
        <td class="print-img-cell">
          <div class="print-img-box">
            {{ if .ImageURL }}
            <img src="{{ .ImageURL }}" alt="{{ .Name }}" />
            {{ end }}
          </div>
        </td>
        <td>
          <div class="print-item-name">{{ .Name }}</div>
          <div class="print-item-type">{{ .TrackingType.Label }}</div>
        </td>
        <td>{{ .CategoryName }}</td>
        <td class="print-col-stock">{{ .TotalStock }}</td>
        <td class="print-col-price">{{ .Pricing.RentalPrice }}</td>
      </tr>
      {{ end }}
    </tbody>
  </table>
  {{ else }}
  <p class="print-empty">No items found.</p>
  {{ end }}

  <div class="print-footer">
    <span>{{ .Data.OrgDisplayName }}</span>
    <span>gearberg.org</span>
  </div>
</div>
<script nonce="{{ .Nonce }}">window.print();</script>
{{ end }}
