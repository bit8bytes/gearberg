{{ define "title" }}Equipment – Print{{ end }}

{{ define "page" }}
<div class="p-8 max-w-5xl mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Equipment List</h1>
    <p class="text-sm text-base-content/60">
      {{ .Data.OrgName }}
      · {{ .Data.PrintDate }}
      · {{ .Data.TotalCount }} items
      {{ if .Data.Query }} · Search: "{{ .Data.Query }}"{{ end }}
      {{ if .Data.Category }} · Category: {{ .Data.Category }}{{ end }}
      {{ if .Data.Currency }} · Currency: {{ .Data.Currency }}{{ end }}
      {{ if .Data.VatRateDisplay }} · VAT: {{ .Data.VatRateDisplay }}{{ end }}
    </p>
  </div>
  {{ if .Data.Inventories }}
  <table class="table w-full">
    <thead>
      <tr>
        <th></th>
        <th>NAME</th>
        <th>CATEGORY</th>
        <th>STOCK</th>
        <th>RENTAL PRICE</th>
      </tr>
    </thead>
    <tbody>
      {{ range .Data.Inventories }}
      <tr>
        <td class="w-20">
          <div class="w-16 h-16 bg-base-200 rounded-lg border-dashed border-2 border-base-300 overflow-hidden flex items-center justify-center">
            {{ if .ImageURL }}
            <img src="{{ .ImageURL }}" alt="{{ .Name }}" class="w-full h-full object-cover" />
            {{ end }}
          </div>
        </td>
        <td class="w-1/3">
          <span class="font-bold">{{ .Name }}</span>
          <br />
          <span class="text-xs text-secondary">{{ .Type.Label }}</span>
        </td>
        <td>{{ .CategoryName }}</td>
        <td>{{ .TotalStock }}</td>
        <td>{{ .RentalPriceInput }}</td>
      </tr>
      {{ end }}
    </tbody>
  </table>
  {{ else }}
  <p class="text-base-content/40 text-sm py-8 text-center">No items found.</p>
  {{ end }}
</div>
<script nonce="{{ .Nonce }}">window.print();</script>
{{ end }}
