{{ define "title" }}{{ if .Data.Item }}{{ .Data.Item.Name }} — Pricing{{ end }}{{ end }}

{{ define "page" }}
{{ template "equipment-header" . }}

<div class="w-full bg-base-100 border-b border-base-200">
  <div class="max-w-5xl mx-auto px-4 min-h-14 flex items-center overflow-x-auto scrollbar-none">
    <div role="tablist" class="tabs tabs-border">
      <a href="/orgs/{{ .Data.OrgID }}/equipment/{{ .Data.ID }}" role="tab" class="tab">Details</a>
      <a href="/orgs/{{ .Data.OrgID }}/equipment/{{ .Data.ID }}/pricing" role="tab" class="tab tab-active">Pricing</a>
      <a href="/orgs/{{ .Data.OrgID }}/equipment/{{ .Data.ID }}/properties" role="tab" class="tab">Properties</a>
      {{ if .Data.Item }}{{ if eq .Data.Item.Type 2 }}
      <a href="/orgs/{{ .Data.OrgID }}/equipment/{{ .Data.ID }}/units" role="tab" class="tab">
        Units
        <span class="badge badge-sm ml-1">{{ .Data.Item.TotalStock }}</span>
      </a>
      {{ end }}{{ end }}
      {{ if .Data.Item }}{{ if .Data.Item.HasContent }}
      <a href="/orgs/{{ .Data.OrgID }}/equipment/{{ .Data.ID }}/content" role="tab" class="tab">Content</a>
      {{ end }}{{ end }}
    </div>
  </div>
</div>

<div class="max-w-5xl w-full mx-auto px-4 my-8">
  <form method="POST" class="flex flex-col gap-4" novalidate>

    <fieldset class="border border-base-300 rounded-lg p-4">
      <legend class="px-1 text-sm font-medium text-base-content/60">Pricing</legend>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-3">

        <div class="flex flex-col gap-1 md:col-span-2">
          <label for="purchase_price" class="label">Purchase Price <span class="text-base-content/40 text-xs">(optional)</span></label>
          <label class="input w-full">
            {{ if .Data.Currency }}<span class="opacity-50">{{ .Data.Currency }}</span>{{ end }}
            <input
              id="purchase_price"
              type="text"
              inputmode="decimal"
              name="purchase_price"
              value="{{ if .Form.PurchasePrice }}{{ .Form.PurchasePrice }}{{ else if .Data.Item }}{{ .Data.Item.PurchasePriceInput }}{{ end }}"
            />
          </label>
          {{ with index .Form.Errors "purchase_price" }}
            <p class="text-error text-sm">{{ . }}</p>
          {{ end }}
        </div>

        <div class="flex flex-col gap-1 md:col-span-2">
          <label for="rental_price" class="label">Rental Price <span class="text-base-content/40 text-xs">(optional)</span></label>
          <label class="input w-full">
            {{ if .Data.Currency }}<span class="opacity-50">{{ .Data.Currency }}</span>{{ end }}
            <input
              id="rental_price"
              type="text"
              inputmode="decimal"
              name="rental_price"
              value="{{ if .Form.RentalPrice }}{{ .Form.RentalPrice }}{{ else if .Data.Item }}{{ .Data.Item.RentalPriceInput }}{{ end }}"
            />
          </label>
          {{ with index .Form.Errors "rental_price" }}
            <p class="text-error text-sm">{{ . }}</p>
          {{ end }}
        </div>

      </div>
    </fieldset>

    <div class="flex gap-2">
      <button type="submit" formaction="/orgs/{{ .Data.OrgID }}/equipment/{{ .Data.ID }}/pricing" class="btn btn-primary" data-loading-trigger>
        {{ template "loading-spinner" . }}
        Save
      </button>
    </div>

  </form>

</div>
{{ end }}
