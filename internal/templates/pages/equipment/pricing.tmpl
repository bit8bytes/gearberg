{{ define "title" }}{{ if .Data.Item }}{{ .Data.Item.Name }} — Pricing{{ end }}{{ end }}

{{ define "page" }}
<div class="max-w-6xl mx-auto px-4 py-8 w-full">

  <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm overflow-hidden">

    <div class="px-6 pt-6 pb-4 border-b border-base-300">
      <div class="flex items-start justify-between gap-4">
        <div>
          <a href="/orgs/{{ .Data.OrgID }}/equipment" class="text-xs font-semibold tracking-widest text-primary uppercase mb-1 hover:underline">&larr; All Items</a>
          <p class="text-3xl font-bold leading-tight">{{ .Data.Item.Name }}</p>
        </div>
      </div>
    </div>

    {{ template "equipment-tab-nav" . }}

    <form method="POST" class="flex flex-col gap-4 px-6 py-4" novalidate>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-3">

        <div class="flex flex-col gap-1 md:col-span-2">
          <label for="purchase_price" class="label">Purchase Price <span class="text-base-content/40 text-xs">(optional)</span></label>
          <label class="input w-full">
            <span hx-get="/orgs/{{ .Data.OrgID }}/currency" hx-trigger="load" hx-swap="outerHTML">{{ template "org-currency-skeleton" . }}</span>
            <input
              id="purchase_price"
              type="number"
              inputmode="decimal"
              step="1"
              min="0"
              name="purchase_price"
              value="{{ .Form.PurchasePrice }}"
            />
          </label>
          {{ with index .Form.Errors "purchase_price" }}
            <p class="text-error text-sm">{{ . }}</p>
          {{ end }}
        </div>

        <div class="flex flex-col gap-1 md:col-span-2">
          <label for="rental_price" class="label">Daily Rental Price <span class="text-base-content/40 text-xs">(optional)</span></label>
          <label class="input w-full">
            <span hx-get="/orgs/{{ .Data.OrgID }}/currency" hx-trigger="load" hx-swap="outerHTML">{{ template "org-currency-skeleton" . }}</span>
            <input
              id="rental_price"
              type="number"
              inputmode="decimal"
              step="0.01"
              min="0"
              name="rental_price"
              value="{{ .Form.RentalPrice }}"
            />
          </label>
          {{ with index .Form.Errors "rental_price" }}
            <p class="text-error text-sm">{{ . }}</p>
          {{ end }}
        </div>

      </div>

      <div id="save" class="flex gap-2">
        <button type="submit" formaction="/orgs/{{ .Data.OrgID }}/equipment/{{ .Data.ID }}/pricing" class="btn btn-primary" data-loading-trigger>
          {{ template "loading-spinner" . }}
          Save
        </button>
      </div>

    </form>
  </div>

</div>
{{ end }}
