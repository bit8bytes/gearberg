{{ define "title" }}Equipment{{ end }}

{{ define "page" }}
<div class="w-full bg-base-200 border-b border-base-300">
  <div class="max-w-5xl mx-auto px-4 h-24 flex items-center justify-between">
    <div>
      <h3>All Items</h3>
      <div class="text-sm text-base-content/50 font-mono">
        <span>{{ .Data.Pagination.TotalRecords }} items</span>
        •
        <span>{{ len .Data.Categories }} categories</span>
      </div>
    </div>
    <div class="flex gap-2">
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost">More ▾</div>
        <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-1 w-36 p-2 shadow border border-base-300">
          <li>
            <a href="{{ .Data.PrintURL }}" target="_blank">
              <span class="w-4 h-4">{{ template "print-icon" . }}</span>
              Print
            </a>
          </li>
          <li>
            <a href="/orgs/{{ .Data.OrgID }}/equipment/import">
              <span class="w-4 h-4">{{ template "import-icon" . }}</span>
              Import
            </a>
          </li>
        </ul>
      </div>
      <a class="btn btn-primary" href="/orgs/{{ .Data.OrgID }}/equipment/new">+ Add Item</a>
    </div>
  </div>
</div>
<div class="w-full bg-base-100 border-b border-base-200">
  <div class="max-w-5xl mx-auto px-4 h-14 flex gap-1 items-center overflow-x-auto scrollbar-none">
    <form method="get" action="/orgs/{{ .Data.OrgID }}/equipment" id="filter-form" data-auto-submit class="flex items-center gap-1 flex-nowrap">
      <label class="input input-sm w-xs shrink-0">
        <span class="flex text-secondary opacity-50 [&>svg]:w-4 [&>svg]:h-4">{{ template "search-icon" . }}</span>
        <input type="search" name="q" placeholder="Search" {{ if $.Data.Query }}value="{{ $.Data.Query }}"{{ end }} />
      </label>
      <select name="category" class="select select-sm">
        <option value="">All categories</option>
        {{ range .Data.Categories }}
        <option value="{{ .Name }}" {{ if eq $.Data.Category .Name }}selected{{ end }}>{{ .Name }}</option>
        {{ end }}
      </select>
    </form>
  </div>
</div>
<div class="max-w-5xl w-full mx-auto px-4 my-[42px]">
  {{ if .Data.Inventories }}
  <div class="overflow-x-auto">
    <table class="table w-full overflow-x-scroll border border-base-300 rounded-lg">
      <thead class="bg-base-200">
        <tr>
          <th></th>
          <th>NAME</th>
          <th class="text-right">CATEGORY</th>
          <th class="text-right">STOCK</th>
        </tr>
      </thead>
      <tbody>
        {{ range .Data.Inventories }}
        <tr>
          <td class="w-16 items-center">
            <div class="w-12 h-12 bg-base-200 rounded-lg border-dashed border-2 border-base-300 overflow-hidden flex items-center justify-center">
              {{ if .ImageURL }}
              <img src="{{ .ImageURL }}" alt="{{ .Name }}" class="w-full h-full object-cover" />
              {{ end }}
            </div>
          </td>
          <td class="w-full">
            <a href="/orgs/{{ $.Data.OrgID }}/equipment/{{ .ID }}"
              class="font-bold link link-hover">
              {{ .Name }}
            </a>
            <br />
            <div class="flex items-center gap-1.5">
              <span class="text-xs text-secondary">{{ .Type.Label }}</span>
              {{ if eq .Kind 2 }}<span class="text-xs text-secondary">• Combination</span>{{ end }}
            </div>
          </td>
          <td>
            <span class="inline-flex items-center gap-1.5">
              <a href="/orgs/{{ $.Data.OrgID }}/settings/equipment-categories/{{ .CategoryID }}" class="link link-hover">{{ .CategoryName }}</a>
            </span>
          </td>
          <td class="w-4 text-right">{{ .TotalStock }}</td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>
  {{ if gt .Data.Pagination.LastPage 1 }}
  <div class="flex items-center gap-1 px-4 py-4">
    {{ $cur := .Data.Pagination.CurrentPage }}
    {{ $last := .Data.Pagination.LastPage }}
    {{ $base := .Data.PageBaseURL }}
    <a href="{{ $base }}page=1"
       class="btn btn-sm{{ if eq $cur 1 }} btn-disabled pointer-events-none{{ end }}"
       {{ if eq $cur 1 }}aria-disabled="true" tabindex="-1"{{ end }}>«</a>
    <a href="{{ $base }}page={{ .Data.Pagination.PrevPage }}"
       class="btn btn-sm{{ if eq $cur 1 }} btn-disabled pointer-events-none{{ end }}"
       {{ if eq $cur 1 }}aria-disabled="true" tabindex="-1"{{ end }}>‹</a>
    <a href="{{ $base }}page={{ .Data.Pagination.NextPage }}"
       class="btn btn-sm{{ if eq $cur $last }} btn-disabled pointer-events-none{{ end }}"
       {{ if eq $cur $last }}aria-disabled="true" tabindex="-1"{{ end }}>›</a>
    <a href="{{ $base }}page={{ $last }}"
       class="btn btn-sm{{ if eq $cur $last }} btn-disabled pointer-events-none{{ end }}"
       {{ if eq $cur $last }}aria-disabled="true" tabindex="-1"{{ end }}>»</a>
  </div>
  {{ end }}
  {{ else }}
  <div class="flex flex-col items-center gap-3 py-16 text-base-content/40">
    {{ if .Data.Query }}
      <p class="text-sm">No items found for "{{ .Data.Query }}".</p>
    {{ else if .Data.Filtered }}
      <p class="text-sm">No items found for the selected category.</p>
    {{ else }}
      <p class="text-sm">No items yet. <a href="/orgs/{{ .Data.OrgID }}/equipment/new" class="link">Add your first item.</a></p>
    {{ end }}
  </div>
  {{ end }}
</div>
{{ end }}
