{{ define "title" }}Equipment{{ end }}

{{ define "page" }}
<div class="max-w-6xl mx-auto px-4 py-8 w-full">

  {{/* Main card */}}
  <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm overflow-hidden">

    {{/* Header block */}}
    <div class="px-6 pt-6 pb-4 border-b border-base-300">
      {{/* Row 1: title + actions */}}
      <div class="flex items-center justify-between gap-4 mb-4">
        <div>
          <span class="text-xs font-semibold tracking-widest text-primary uppercase mb-1">Your Gear</span>
          <p class="text-3xl font-bold leading-tight">All Items</p>
        </div>
        <div class="hidden sm:flex sm:flex-row items-center gap-2">
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost border border-base-300 w-full">
              <span>More</span>
              <span class="size-6">{{ template "chevron-down" . }}</span>
            </div>
            <ul tabindex="-1" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 gap-1 shadow">
              <li>
                {{ if .Data.ImportSessionID }}
                <a href="/orgs/{{ .Data.OrgID }}/import/{{ .Data.ImportSessionID }}" class="w-full flex flex-col items-start py-2">
                  <span class="flex items-center gap-2 font-medium">
                    <span class="size-6">{{ template "import-icon" . }}</span>
                    Resume Import
                  </span>
                </a>
                {{ else }}
                <button data-modal-target="import-dialog" class="w-full flex flex-col items-start py-2">
                  <span class="flex items-center gap-2 font-medium">
                    <span class="size-6">{{ template "import-icon" . }}</span>
                    Import
                  </span>
                </button>
                {{ end }}
              </li>
              <li>
                <button data-modal-target="export-dialog" class="w-full flex flex-col items-start py-2">
                  <span class="flex items-center gap-2 font-medium">
                    <span class="size-6">{{ template "export-icon" . }}</span>
                    Export
                  </span>
                </button>
              </li>
              <li>
                <a href="{{ .Data.PrintURL }}" target="_blank" class="flex flex-col items-start py-2">
                  <span class="flex items-center gap-2 font-medium">
                    <span class="size-6">{{ template "print-icon" . }}</span>
                    Print
                  </span>
                </a>
              </li>
            </ul>
          </div>
          <a class="btn btn-primary" href="/orgs/{{ .Data.OrgID }}/equipment/new">
            <span class="size-6">{{ template "add-icon" . }}</span>
            <span>Add Item</span>
          </a>
        </div>
      </div>
      <div class="border-b border-base-300 -mx-6"></div>
      {{/* Row 2: search + filter */}}
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 pt-4">
        <label class="input w-full sm:w-64">
          <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g stroke-linejoin="round" stroke-linecap="round" stroke-width="2.5" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></g></svg>
          <input
            type="search"
            name="q"
            placeholder="Search name or serial number…"
            {{ if $.Data.Query }}value="{{ $.Data.Query }}"{{ end }}
            hx-get="/orgs/{{ .Data.OrgID }}/equipment"
            hx-trigger="input changed delay:300ms"
            hx-target="#equipment-results"
            hx-swap="innerHTML"
            hx-include="[name='category']"
            hx-indicator="#search-indicator"
            hx-push-url="true"
          />
        </label>
        <select
          name="category"
          class="select w-full sm:w-auto"
          hx-get="/orgs/{{ .Data.OrgID }}/equipment"
          hx-trigger="change"
          hx-target="#equipment-results"
          hx-swap="innerHTML"
          hx-include="[name='q']"
          hx-indicator="#search-indicator"
          hx-push-url="true"
        >
          <option value="">All categories</option>
          {{ range .Data.Categories }}
          <option value="{{ .Name }}" {{ if eq $.Data.Category .Name }}selected{{ end }}>{{ .Name }}</option>
          {{ end }}
        </select>
        <span id="search-indicator" class="htmx-indicator loading loading-spinner loading-xs text-primary"></span>
      </div>
    </div>

    {{/* Table + Pagination */}}
    <div id="equipment-results">
      {{ template "equipment-search" . }}
    </div>

  </div>{{/* end card */}}
</div>

{{/* Export dialog */}}
<dialog id="export-dialog" class="modal">
  <div class="modal-box">
    <h3 class="text-xl font-bold">Export Equipment CSV</h3>
    <div role="alert" class="alert text-sm mt-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <p class="font-medium">Not included in the export</p>
        <ul class="mt-1 list-disc list-inside space-y-0.5 text-base-content/70">
          <li>Images</li>
          <li>The Content tab of serialized equipment</li>
        </ul>
      </div>
    </div>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-ghost">Cancel</button>
      </form>
      <a href="/orgs/{{ .Data.OrgID }}/equipment/export" class="btn btn-primary">Download CSV</a>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

{{ template "photo-viewer-dialog" . }}

{{/* Import dialog */}}
<dialog id="import-dialog" class="modal">
  <div class="modal-box p-0 overflow-hidden">
    <div class="px-6 pt-6 pb-4 border-b border-base-300">
      <h3 class="text-xl font-bold">Import Equipment</h3>
      <p class="text-sm text-base-content/50 mt-0.5">Upload a CSV file to import equipment in bulk.</p>
    </div>
    <div class="p-6">
      <form id="import-form" method="POST" action="/orgs/{{ .Data.OrgID }}/import" enctype="multipart/form-data">
        <label
          id="import-drop-zone"
          for="import-file-input"
          class="flex flex-col items-center justify-center gap-3 rounded-xl border-2 border-dashed border-base-300 bg-base-200/40 hover:bg-base-200/80 hover:border-primary/40 transition-colors cursor-pointer min-h-40 px-8 text-center"
        >
          <span class="size-8">{{ template "import-icon" . }}</span>
          <div>
            <p class="font-medium text-base-content">Drop your CSV here</p>
            <p class="text-sm text-base-content/50 mt-0.5">or click to browse</p>
          </div>
        </label>
        <input id="import-file-input" type="file" name="file" accept=".csv,text/csv" class="sr-only" required />
        <p class="text-xs text-base-content/40 mt-3 text-center">
          Use the <a href="/orgs/{{ .Data.OrgID }}/import/template" class="link link-primary">template CSV</a> to ensure columns match.
        </p>
      </form>
    </div>
    <div class="modal-action px-6 pb-6 mt-0">
      <form method="dialog">
        <button class="btn btn-ghost">Cancel</button>
      </form>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script nonce="{{ .Nonce }}">
  (function () {
    const input = document.getElementById('import-file-input');
    const zone  = document.getElementById('import-drop-zone');
    const form  = document.getElementById('import-form');

    input.addEventListener('change', () => { if (input.files.length) form.submit(); });

    zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('border-primary', 'bg-base-200'); });
    zone.addEventListener('dragleave', () => zone.classList.remove('border-primary', 'bg-base-200'));
    zone.addEventListener('drop', e => {
      e.preventDefault();
      zone.classList.remove('border-primary', 'bg-base-200');
      const files = e.dataTransfer.files;
      if (!files.length) return;
      const dt = new DataTransfer();
      dt.items.add(files[0]);
      input.files = dt.files;
      form.submit();
    });
  })();
</script>

{{/* FAB: Mobile only */}}
<div class="fab fab-flower sm:hidden">
  <div tabindex="0" role="button" class="btn btn-circle btn-lg">
    <span class="size-6">{{ template "dot-menu-icon" . }}</span>
  </div>
  <a href="/orgs/{{ .Data.OrgID }}/equipment/new" class="btn btn-circle btn-lg btn-primary">
    <span class="size-6">{{ template "add-icon" . }}</span>
  </a>
  {{ if .Data.ImportSessionID }}
  <a href="/orgs/{{ .Data.OrgID }}/import/{{ .Data.ImportSessionID }}" class="btn btn-circle btn-lg">
    <span class="size-6">{{ template "import-icon" . }}</span>
  </a>
  {{ else }}
  <button data-modal-target="import-dialog" class="btn btn-circle btn-lg">
    <span class="size-6">{{ template "import-icon" . }}</span>
  </button>
  {{ end }}
  <button data-modal-target="export-dialog" class="btn btn-circle btn-lg">
    <span class="size-6">{{ template "export-icon" . }}</span>
  </button>
  <a href="{{ .Data.PrintURL }}" target="_blank" class="btn btn-circle btn-lg">
    <span class="size-6">{{ template "print-icon" . }}</span>
  </a>
</div>

{{ end }}
