{{ define "title" }}Equipment{{ end }}

{{ define "page" }}
<div class="w-full bg-base-200 border-b border-base-300">
  <div class="max-w-5xl md:mx-auto px-4 py-3 md:h-24 flex flex-row items-center justify-between gap-2">
    <div>
      <h3>All Items</h3>
      <div class="text-sm text-base-content/50 font-mono">
        <span>{{ .Data.Pagination.TotalRecords }} items</span>
        •
        <span>{{ len .Data.Categories }} categories</span>
      </div>
    </div>
    <div class="flex gap-2 shrink-0">
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost">
          <span class="md:hidden w-4 h-4">{{ template "dot-menu-icon" . }}</span>
          <span class="hidden md:inline">More ▾</span>
        </div>
        <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-1 w-48 p-2 shadow border border-base-300">
          <li>
            <a href="{{ .Data.PrintURL }}" target="_blank">
              <span class="w-4 h-4">{{ template "print-icon" . }}</span>
              Print
            </a>
          </li>
          <li>
            <a href="/orgs/{{ .Data.OrgID }}/equipment/import">
              <span class="w-4 h-4">{{ template "import-icon" . }}</span>
              Import
            </a>
          </li>
          <li>
            <button data-modal-target="export-dialog" class="w-full">
              <span class="w-4 h-4">{{ template "export-icon" . }}</span>
              Export CSV
            </button>
          </li>
        </ul>
      </div>
      <a class="btn btn-primary" href="/orgs/{{ .Data.OrgID }}/equipment/new">
        <span class="md:hidden">+</span>
        <span class="hidden md:inline">+ Add Item</span>
      </a>
    </div>
  </div>
</div>
<div class="w-full bg-base-100 border-b border-base-200">
  <div class="max-w-5xl mx-auto px-4 py-2 md:h-14 flex items-center">
    <form method="get" action="/orgs/{{ .Data.OrgID }}/equipment" id="filter-form" data-auto-submit class="flex items-center gap-1 flex-wrap md:flex-nowrap w-full">
      <label class="input w-full md:w-xs md:flex-none">
        <span class="flex text-secondary opacity-50 [&>svg]:w-4 [&>svg]:h-4">{{ template "search-icon" . }}</span>
        <input type="search" name="q" placeholder="Search" {{ if $.Data.Query }}value="{{ $.Data.Query }}"{{ end }} />
      </label>
      <select name="category" class="select w-full md:w-auto">
        <option value="">All categories</option>
        {{ range .Data.Categories }}
        <option value="{{ .Name }}" {{ if eq $.Data.Category .Name }}selected{{ end }}>{{ .Name }}</option>
        {{ end }}
      </select>
    </form>
  </div>
</div>
<div class="max-w-5xl w-full mx-auto px-4 my-[42px]">
  {{ if .Data.Inventories }}
  <div class="overflow-x-auto">
    <table class="table w-full overflow-x-scroll border border-base-300 rounded-lg">
      <thead class="bg-base-200">
        <tr>
          <th></th>
          <th>NAME</th>
          <th class="text-right">STOCK</th>
        </tr>
      </thead>
      <tbody>
        {{ range .Data.Inventories }}
        <tr>
          <td class="w-16 items-center">
             <div class="w-16 h-16 bg-base-200 rounded-lg border-dashed border-2 border-base-300 overflow-hidden flex items-center justify-center">
              {{ if .ImageURL }}
              <button type="button" class="cursor-pointer w-full h-full" data-modal-target="photo-viewer-dialog" data-photo-src="{{ .ImageURL }}">
                <img src="{{ .ImageURL }}" alt="{{ .Name }}" class="w-full h-full object-contain" />
              </button>
              {{ end }}
            </div>
          </td>
          <td class="w-full">
            <a href="/orgs/{{ $.Data.OrgID }}/equipment/{{ .ID }}"
              class="font-bold link link-hover">
              {{ .Name }}
            </a>
            <br />
            <div class="flex items-center gap-1.5">
              <span class="text-xs text-secondary">{{ .TrackingType.Label }}</span>
              {{ if eq .Kind 2 }}<span class="text-xs text-secondary">• Combination</span>{{ end }}
              <span class="text-xs text-secondary">• <a href="/orgs/{{ $.Data.OrgID }}/settings/equipment-categories/{{ .CategoryID }}" class="link link-hover">{{ .CategoryName }}</a></span>
            </div>
          </td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>
  {{ if gt .Data.Pagination.LastPage 1 }}
  <div class="flex items-center gap-1 px-4 py-4">
    {{ $cur := .Data.Pagination.CurrentPage }}
    {{ $last := .Data.Pagination.LastPage }}
    {{ $base := .Data.PageBaseURL }}
    <a href="{{ $base }}page=1"
       class="btn btn-sm{{ if eq $cur 1 }} btn-disabled pointer-events-none{{ end }}"
       {{ if eq $cur 1 }}aria-disabled="true" tabindex="-1"{{ end }}>«</a>
    <a href="{{ $base }}page={{ .Data.Pagination.PrevPage }}"
       class="btn btn-sm{{ if eq $cur 1 }} btn-disabled pointer-events-none{{ end }}"
       {{ if eq $cur 1 }}aria-disabled="true" tabindex="-1"{{ end }}>‹</a>
    <a href="{{ $base }}page={{ .Data.Pagination.NextPage }}"
       class="btn btn-sm{{ if eq $cur $last }} btn-disabled pointer-events-none{{ end }}"
       {{ if eq $cur $last }}aria-disabled="true" tabindex="-1"{{ end }}>›</a>
    <a href="{{ $base }}page={{ $last }}"
       class="btn btn-sm{{ if eq $cur $last }} btn-disabled pointer-events-none{{ end }}"
       {{ if eq $cur $last }}aria-disabled="true" tabindex="-1"{{ end }}>»</a>
  </div>
  {{ end }}
  {{ else }}
  <div class="flex flex-col items-center gap-3 py-16 text-base-content/40">
    {{ if .Data.Query }}
      <p class="text-sm">No items found for "{{ .Data.Query }}".</p>
    {{ else if .Data.Filtered }}
      <p class="text-sm">No items found for the selected category.</p>
    {{ else }}
      <p class="text-sm">No items yet. <a href="/orgs/{{ .Data.OrgID }}/equipment/new" class="link">Add your first item.</a></p>
    {{ end }}
  </div>
  {{ end }}
</div>

<dialog id="export-dialog" class="modal">
  <div class="modal-box">
    <h3 class="text-xl font-bold">Export Equipment CSV</h3>
    <div role="alert" class="alert text-sm mt-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <p class="font-medium">Not included in the export</p>
        <ul class="mt-1 list-disc list-inside space-y-0.5 text-base-content/70">
          <li>Images</li>
          <li>The Content tab of serialized equipment</li>
        </ul>
      </div>
    </div>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-ghost">Cancel</button>
      </form>
      <a href="/orgs/{{ .Data.OrgID }}/equipment/export" class="btn btn-primary">Download CSV</a>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

{{ template "photo-viewer-dialog" . }}
{{ end }}
