{{ define "title" }}Equipment{{ end }}

{{ define "page" }}
<div class="max-w-6xl mx-auto px-4 py-8 w-full">

  {{/* Main card */}}
  <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm overflow-hidden">

    {{/* Header block */}}
    <div class="px-6 pt-6 pb-4 border-b border-base-300">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold tracking-widest text-primary uppercase mb-1">Your Gear</p>
          <p class="text-3xl font-bold leading-tight">All Items</p>
        </div>
        <div class="flex items-center gap-2 shrink-0 pt-1">
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost border border-base-300">
              More
              <span class="size-4">{{ template "chevron-down" . }}</span>
            </div>
            <ul tabindex="-1" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 gap-1 shadow">
              <li>
                <a href="/orgs/{{ .Data.OrgID }}/equipment/import" class="flex flex-col items-start py-2">
                  <span class="flex items-center gap-2 font-medium">
                    <span class="size-4">{{ template "import-icon" . }}</span>
                    Import
                  </span>
                </a>
              </li>
              <li>
                <button data-modal-target="export-dialog" class="w-full flex flex-col items-start py-2">
                  <span class="flex items-center gap-2 font-medium">
                    <span class="size-4">{{ template "export-icon" . }}</span>
                    Export
                  </span>
                </button>
              </li>
              <li>
                <a href="{{ .Data.PrintURL }}" target="_blank" class="flex flex-col items-start py-2">
                  <span class="flex items-center gap-2 font-medium">
                    <span class="size-4">{{ template "print-icon" . }}</span>
                    Print
                  </span>
                </a>
              </li>
            </ul>
          </div>
          <a class="btn btn-primary" href="/orgs/{{ .Data.OrgID }}/equipment/new">
            <span class="size-4">{{ template "add-icon" . }}</span>
            Add Item
          </a>
        </div>
      </div>

      {{/* Stats row */}}
      <div class="flex flex-wrap items-center gap-2 mt-4">
        <span class="badge badge-ghost border border-base-300 font-mono text-sm px-3 py-2 h-auto">
          <span class="font-bold">{{ .Data.Pagination.TotalRecords }}</span>item{{ if gt .Data.Pagination.TotalRecords 1 }}s{{ end }}
        </span>
        <span class="badge badge-ghost border border-base-300 font-mono text-sm px-3 py-2 h-auto">
          <span class="font-bold">{{ len .Data.Categories }}</span>categor{{ if gt (len .Data.Categories) 1 }}ies{{ else }}y{{ end }}
        </span>
      </div>
    </div>

    {{/* Toolbar */}}
    <div class="px-6 py-3 border-b border-base-300 flex flex-wrap items-center gap-2">
      <form method="get" action="/orgs/{{ .Data.OrgID }}/equipment" id="filter-form" data-auto-submit class="contents">
        <label class="input input-sm w-full sm:w-64 flex-none">
          <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g stroke-linejoin="round" stroke-linecap="round" stroke-width="2.5" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></g></svg>
          <input type="search" name="q" placeholder="Search name or serial number…" {{ if $.Data.Query }}value="{{ $.Data.Query }}"{{ end }} />
        </label>
        <select name="category" class="select select-sm w-full sm:w-auto">
          <option value="">All categories</option>
          {{ range .Data.Categories }}
          <option value="{{ .Name }}" {{ if eq $.Data.Category .Name }}selected{{ end }}>{{ .Name }}</option>
          {{ end }}
        </select>
      </form>
    </div>

    {{/* Table */}}
    {{ if .Data.Inventories }}
    <div class="overflow-x-auto">
      <table class="table w-full">
        <thead class="bg-base-200 text-xs uppercase tracking-wide text-base-content/60">
          <tr>
            <th class="w-20"></th>
            <th>Name</th>
            <th>Category</th>
            <th class="text-right">Stock</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{ range .Data.Inventories }}
          <tr class="border-b border-base-200 last:border-0">
            <td class="py-3 pl-4 pr-2">
              <div class="w-14 h-14 bg-base-200 rounded-lg border-dashed border-2 border-base-300 overflow-hidden flex items-center justify-center shrink-0">
                {{ if .ImageURL }}
                <button type="button" class="cursor-pointer w-full h-full" data-modal-target="photo-viewer-dialog" data-photo-src="{{ .ImageURL }}">
                  <img src="{{ .ImageURL }}" alt="{{ .Name }}" class="w-full h-full object-contain" />
                </button>
                {{ end }}
              </div>
            </td>
            <td class="py-3">
              <a href="/orgs/{{ $.Data.OrgID }}/equipment/{{ .ID }}" class="font-semibold link link-hover block leading-tight">{{ .Name }}</a>
              <div class="flex items-center gap-1.5 mt-0.5">
                <span class="badge badge-sm badge-ghost border border-base-300 text-xs">{{ .TrackingType.Label }}</span>
              </div>
            </td>
            <td class="py-3">
              {{ if .CategoryName }}
              <span class="badge badge-ghost border border-base-300 text-xs">
                {{ .CategoryName }}
              </span>
              {{ end }}
            </td>
            <td class="py-3 text-right">
              <span class="font-mono font-bold text-base">{{ .TotalStock }}</span>
            </td>
            <td class="py-3 text-right pr-4">
              <div class="flex items-center justify-end gap-1">
                {{ if eq .TrackingType.String "serialized" }}
                <a href="/orgs/{{ $.Data.OrgID }}/equipment/{{ .ID }}/units" class="btn btn-ghost btn-sm btn-square" title="View units">
                  <span class="w-4 h-4">{{ template "units-icon" . }}</span>
                </a>
                {{ end }}
                <a href="/orgs/{{ $.Data.OrgID }}/equipment/{{ .ID }}" class="btn btn-ghost btn-sm btn-square" title="Edit">
                  <span class="w-4 h-4">{{ template "edit-icon" . }}</span>
                </a>
              </div>
            </td>
          </tr>
          {{ end }}
        </tbody>
      </table>
    </div>

    {{/* Pagination */}}
    {{ if gt .Data.Pagination.LastPage 1 }}
    <div class="flex items-center gap-1 px-6 py-4 border-t border-base-300">
      {{ $cur := .Data.Pagination.CurrentPage }}
      {{ $last := .Data.Pagination.LastPage }}
      {{ $base := .Data.PageBaseURL }}
      <a href="{{ $base }}page=1"
         class="btn btn-sm{{ if eq $cur 1 }} btn-disabled pointer-events-none{{ end }}"
         {{ if eq $cur 1 }}aria-disabled="true" tabindex="-1"{{ end }}>«</a>
      <a href="{{ $base }}page={{ .Data.Pagination.PrevPage }}"
         class="btn btn-sm{{ if eq $cur 1 }} btn-disabled pointer-events-none{{ end }}"
         {{ if eq $cur 1 }}aria-disabled="true" tabindex="-1"{{ end }}>‹</a>
      <a href="{{ $base }}page={{ .Data.Pagination.NextPage }}"
         class="btn btn-sm{{ if eq $cur $last }} btn-disabled pointer-events-none{{ end }}"
         {{ if eq $cur $last }}aria-disabled="true" tabindex="-1"{{ end }}>›</a>
      <a href="{{ $base }}page={{ $last }}"
         class="btn btn-sm{{ if eq $cur $last }} btn-disabled pointer-events-none{{ end }}"
         {{ if eq $cur $last }}aria-disabled="true" tabindex="-1"{{ end }}>»</a>
    </div>
    {{ end }}

    {{ else }}
    <div class="flex flex-col items-center gap-3 py-16 text-base-content/40">
      {{ if .Data.Query }}
        <p class="text-sm">No items found for "{{ .Data.Query }}".</p>
      {{ else if .Data.Filtered }}
        <p class="text-sm">No items found for the selected category.</p>
      {{ else }}
        <p class="text-sm">No items yet. <a href="/orgs/{{ .Data.OrgID }}/equipment/new" class="link">Add your first item.</a></p>
      {{ end }}
    </div>
    {{ end }}

  </div>{{/* end card */}}
</div>

{{/* Export dialog */}}
<dialog id="export-dialog" class="modal">
  <div class="modal-box">
    <h3 class="text-xl font-bold">Export Equipment CSV</h3>
    <div role="alert" class="alert text-sm mt-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <p class="font-medium">Not included in the export</p>
        <ul class="mt-1 list-disc list-inside space-y-0.5 text-base-content/70">
          <li>Images</li>
          <li>The Content tab of serialized equipment</li>
        </ul>
      </div>
    </div>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-ghost">Cancel</button>
      </form>
      <a href="/orgs/{{ .Data.OrgID }}/equipment/export" class="btn btn-primary">Download CSV</a>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

{{ template "photo-viewer-dialog" . }}
{{ end }}
