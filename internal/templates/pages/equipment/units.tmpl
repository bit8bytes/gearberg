{{ define "title" }}{{ .Data.ItemName }} — Units{{ end }}

{{ define "page" }}
{{ template "equipment-header" . }}

{{ template "equipment-tab-nav" . }}

<div class="max-w-5xl w-full mx-auto mb-16">

  {{/* Delete forms live outside the table to avoid nesting. */}}
  {{ range .Data.Units }}
  <form id="unit-{{ .ID }}-delete" method="POST" action="/orgs/{{ $.Data.OrgID }}/equipment/{{ $.Data.ID }}/units/{{ .ID }}/delete"></form>
  {{ end }}

  {{ if .Data.Units }}
  <div class="overflow-x-auto my-8 pb-16">
    <table class="table table-sm hover w-full">
      <thead>
        <tr>
          <th>SERIAL</th>
          <th>STATUS</th>
          <th>MFR SERIAL</th>
          <th>NEXT INSPECTION</th>
          <th class="text-right">PURCHASE PRICE</th>
          <th>PURCHASED</th>
          <th>NOTES</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{ range .Data.Units }}
        <tr>
          <td class="whitespace-nowrap">
            <span class="badge badge-ghost font-mono text-xs">{{ .SerialNumber }}</span>
          </td>
          <td>
            {{ if .IsActive }}
              <span class="badge badge-success badge-sm">Active</span>
            {{ else }}
              <span class="badge badge-ghost badge-sm">Inactive</span>
            {{ end }}
          </td>
          <td class="text-sm">{{ if .ManufacturerSerialNumber }}{{ .ManufacturerSerialNumber }}{{ else }}<span class="text-base-content/30">—</span>{{ end }}</td>
          <td class="text-sm">
            {{ $next := .NextInspectionAtInput }}
            {{ $label := .NextInspectionLabel }}
            {{ if $next }}
            <div class="flex flex-col gap-0.5">
              <span class="font-mono text-xs">{{ $next }}</span>
              {{ if $label }}
                {{ if .IsInspectionOverdue }}
                  <span class="text-xs text-error font-medium">{{ $label }}</span>
                {{ else }}
                  <span class="text-xs text-base-content/40">{{ $label }}</span>
                {{ end }}
              {{ end }}
            </div>
            {{ else }}<span class="text-base-content/30">—</span>{{ end }}
          </td>
          <td class="text-sm text-right">{{ if .PurchasePriceInput }}{{ .PurchasePriceInput }}{{ else }}<span class="text-base-content/30">—</span>{{ end }}</td>
          <td class="font-mono text-xs">{{ if .PurchasedAtInput }}{{ .PurchasedAtInput }}{{ else }}<span class="text-base-content/30">—</span>{{ end }}</td>
          <td class="text-sm max-w-xs">
            {{ if .Notes }}<span class="truncate block" title="{{ .Notes }}">{{ .Notes }}</span>{{ else }}<span class="text-base-content/30">—</span>{{ end }}
          </td>
          <td class="text-right">
            <div class="flex gap-1 justify-end">
              <button data-modal-target="unit-modal-{{ .ID }}" class="btn btn-sm btn-ghost">Edit</button>
              <details class="dropdown dropdown-end">
                <summary class="btn btn-sm btn-ghost btn-square">
                  <span class="w-4 h-4">{{ template "dot-menu-icon" . }}</span>
                </summary>
                <ul class="dropdown-content menu bg-base-100 rounded-box z-1 w-52 p-1 shadow border border-base-300">
                  <li>
                    <a href="/orgs/{{ $.Data.OrgID }}/equipment/{{ $.Data.ID }}/units/{{ .ID }}/qr" title="Download QR">
                      <span class="w-4 h-4">{{ template "qr-icon" . }}</span>
                      QR Code
                    </a>
                  </li>
                  <li>
                    <button
                      form="unit-{{ .ID }}-delete"
                      type="submit"
                      class="text-error"
                      data-confirm="Delete unit {{ .SerialNumber }}?"
                    >
                    <span class="w-4 h-4">{{ template "delete-icon" . }}</span>
                    Delete</button>
                  </li>
                </ul>
              </details>
            </div>
          </td>
        </tr>
        {{ end }}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="10" class="text-right pt-2 px-4">
            <form method="POST" action="/orgs/{{ .Data.OrgID }}/equipment/{{ .Data.ID }}/units">
              <button type="submit" class="btn btn-sm btn-primary">Add unit</button>
            </form>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
  {{ else }}
  <div class="flex flex-col items-center gap-3 py-16 text-base-content/40">
    <p class="text-sm">No units recorded.
      <form class="inline" method="POST" action="/orgs/{{ .Data.OrgID }}/equipment/{{ .Data.ID }}/units">
        <button type="submit" class="link">Add the first unit.</button>
      </form>
    </p>
  </div>
  {{ end }}

  {{/* Unit edit modals — one per unit */}}
  {{ range .Data.Units }}
  <dialog id="unit-modal-{{ .ID }}" class="modal">
    <div class="modal-box max-w-md flex flex-col gap-4">
      <h3 class="font-semibold">Unit {{ .SerialNumber }}</h3>

      <form id="unit-edit-{{ .ID }}" method="POST" action="/orgs/{{ $.Data.OrgID }}/equipment/{{ $.Data.ID }}/units/{{ .ID }}" class="flex flex-col gap-4">

        <div class="flex flex-col gap-1">
          <label class="label cursor-pointer gap-3 self-start">
            <span>Active</span>
            <input type="checkbox" name="status_id" value="1" class="toggle toggle-success" {{ if .IsActive }}checked{{ end }} />
          </label>
          <p class="text-base-content/50 text-xs">Inactive units are not available for rental.</p>
        </div>

        <div class="flex flex-col gap-1">
          <label>Manufacturer Serial Number <span class="text-base-content/40 text-xs">(optional)</span></label>
          <input type="text" name="serial_number" value="{{ .ManufacturerSerialNumber }}" maxlength="200" class="input w-full" placeholder="—" />
        </div>

        <div class="flex flex-col gap-1">
          <label>Purchase Price <span class="text-base-content/40 text-xs">(optional)</span></label>
          <input type="text" name="purchase_price" value="{{ .PurchasePriceInput }}" class="input w-full" placeholder="—" />
        </div>

        <div class="flex flex-col gap-1">
          <label>Purchased <span class="text-base-content/40 text-xs">(optional)</span></label>
          <input type="date" name="purchased_at" value="{{ .PurchasedAtInput }}" class="input w-full" />
        </div>

        <div class="flex flex-col gap-1">
          <label>Next Inspection <span class="text-base-content/40 text-xs">(optional)</span></label>
          <input type="date" name="next_inspection_at" value="{{ .NextInspectionAtInput }}" class="input w-full" />
        </div>

        <div class="flex flex-col gap-1">
          <label>Notes <span class="text-base-content/40 text-xs">(optional)</span></label>
          <textarea name="notes" maxlength="1000" class="textarea w-full" placeholder="—">{{ .Notes }}</textarea>
        </div>

      </form>

      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-ghost">Cancel</button>
        </form>
        <button type="submit" form="unit-edit-{{ .ID }}" class="btn btn-primary" data-loading-trigger>
          {{ template "loading-spinner" . }}
          Save
        </button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>
  {{ end }}

</div>

{{ end }}
