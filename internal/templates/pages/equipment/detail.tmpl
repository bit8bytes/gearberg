{{ define "title" }}{{ .Form.Name }}{{ end }}

{{ define "page" }}
<div class="max-w-6xl mx-auto px-4 py-8 w-full">

  {{/* Main card */}}
  <div class="card bg-base-100 rounded-2xl border border-base-300 shadow-sm overflow-hidden">
    
    {{/* Header block */}}
    <div class="px-6 pt-6 pb-4 border-b border-base-300">
      <div class="flex items-start justify-between gap-4">
        <div>
          <a href="/orgs/{{ .Data.OrgID }}/equipment" class="text-xs font-semibold tracking-widest text-primary uppercase mb-1 hover:underline">Your Gear</a>
          <p class="text-3xl font-bold leading-tight">{{ .Form.Name }}</p>
        </div>
        <div class="shrink-0 pt-1">
          <button type="button" data-modal-target="delete_equipment_modal" class="btn btn-ghost text-error">
            <span class="w-4 h-4">{{ template "delete-icon" }}</span>
            Delete
          </button>
        </div>
      </div>
    </div>

    {{/* Tab Navigation */}}
    {{ template "equipment-tab-nav" . }}

    {{/* Tab Content */}}
    <form 
      method="POST" 
      enctype="multipart/form-data" 
      class="flex flex-col gap-4 px-6 py-4" novalidate>
      <div class="flex flex-col gap-4">

        {{ template "photo-picker" . }}

        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
          
          <div class="flex flex-col gap-1 md:col-span-2">
            <label for="name" class="label">Name</label>
            <input
            id="name"
            type="text"
            name="name"
            value="{{ .Form.Name }}"
            maxlength="200"
            class="input w-full"
            />
            {{ with index .Form.Errors "name" }}
            <p class="text-error text-sm">{{ . }}</p>
            {{ end }}
          </div>

          <div class="flex flex-col gap-1 md:col-span-2">
            <label class="label">Tracking Type</label>
            <input type="text" value="{{ if eq .Form.Type.String "bulk" }}Bulk{{ else }}Serialized{{ end }}" class="input w-full" disabled />
          </div>
          
          <div class="flex flex-col gap-1 md:col-span-2">
            <label for="category_input" class="label">Category</label>
            <div
              hx-get="/orgs/{{ .Data.OrgID }}/equipment-categories{{ if .Form.CategoryID }}?selected={{ .Form.CategoryID }}{{ else if .Form.CategoryName }}?selected_name={{ .Form.CategoryName | urlquery }}{{ end }}"
              hx-trigger="load"
              hx-swap="outerHTML">
              {{ template "equipment-categories-skeleton" . }}
            </div>
            {{ with index .Form.Errors "category_id" }}
              <p class="text-error text-sm">{{ . }}</p>
            {{ end }}
          </div>

          <div class="flex flex-col gap-1 md:col-span-2">
            <label for="manufacturer_input" class="label">Manufacturer</label>
            <div
              hx-get="/orgs/{{ .Data.OrgID }}/equipment-manufacturers{{ if .Form.ManufacturerID }}?selected={{ .Form.ManufacturerID }}{{ else if .Form.ManufacturerName }}?selected_name={{ .Form.ManufacturerName | urlquery }}{{ end }}"
              hx-trigger="load"
              hx-swap="outerHTML">
              {{ template "equipment-manufacturers-skeleton" . }}
            </div>
          </div>

          <div class="flex flex-col gap-1 md:col-span-2">
            <label for="location_input" class="label">Stock Location</label>
            <div
              hx-get="/orgs/{{ .Data.OrgID }}/warehouse-locations{{ if .Form.LocationID }}?selected={{ .Form.LocationID }}{{ else if .Form.LocationName }}?selected_name={{ .Form.LocationName | urlquery }}{{ end }}"
              hx-trigger="load"
              hx-swap="outerHTML">
              {{ template "warehouse-locations-skeleton" . }}
            </div>
          </div>

          {{ if eq .Form.Type.String "bulk" }}
          <div class="flex flex-col gap-1 md:col-span-2">
            <label for="total_stock" class="label">Total Stock</label>
            <input
              id="total_stock"
              type="number"
              name="total_stock"
              value="{{ .Form.TotalStock }}"
              min="1"
              class="input w-full"
            />
            {{ with index .Form.Errors "total_stock" }}
              <p class="text-error text-sm">{{ . }}</p>
            {{ end }}
          </div>
          {{ end }}

          <div class="flex flex-col gap-1 md:col-span-4">
            <label for="notes" class="label">Notes <span class="text-base-content/40 text-xs">(optional)</span></label>
            <textarea id="notes" name="notes" class="textarea w-full" rows="3">{{ .Form.Notes }}</textarea>
          </div>

        </div>

      </div>

      <input type="hidden" name="type_id" value="{{ .Form.Type }}" />
      <div id="save" class="flex gap-2">
        <button type="submit" formaction="/orgs/{{ .Data.OrgID }}/equipment/{{ .Data.ID }}/details" class="btn btn-primary" data-loading-trigger>
          {{ template "loading-spinner" . }}
          Save
        </button>
      </div>

    </form>
  </div>

  {{ template "photo-picker-dialog" . }}

</div>

<dialog id="delete_equipment_modal" class="modal">
  <div class="modal-box">
    <h3>Delete Equipment</h3>
    <p class="py-4">Are you sure you want to permanently delete <strong>{{ .Form.Name }}</strong>? This action cannot be undone.</p>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn">Cancel</button>
      </form>
      <form method="POST" action="/orgs/{{ .Data.OrgID }}/equipment/{{ .Data.ID }}/delete">
        <button type="submit" class="btn btn-error">Delete</button>
      </form>
    </div>
  </div>
</dialog>
{{ end }}
