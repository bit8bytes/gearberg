{{ define "title" }}Equipment &amp; Rental Management{{ end }}
{{ define "description" }}The affordable Rentman alternative for hobby and solo. Free to self-host with equipment tracking and rentals. Desktop app coming soon for equipment-only use. Open-source with no lock-in.{{ end }}

{{ define "seo" }}
<meta property="og:type" content="website" />
<meta property="og:title" content="Gearberg — Track your gear. Run your rentals." />
<meta property="og:description" content="Free, open-source, self-hostable inventory and rental management. No subscriptions, no lock-in." />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content="Gearberg — Track your gear. Run your rentals." />
<meta name="twitter:description" content="Free, open-source, self-hostable inventory and rental management. No subscriptions, no lock-in." />
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Gearberg",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Linux, macOS, Windows",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "license": "https://www.gnu.org/licenses/agpl-3.0.html",
  "url": "https://github.com/bit8bytes/gearberg",
  "description": "Free, open-source, self-hostable inventory and rental management system.",
  "keywords": "inventory management, rental management, self-hosted, open source, equipment tracking"
}
</script>
{{ end }}

{{ define "page" }}
<main>
{{/* Hero Section */}}
<section class="hero bg-base-200 min-h-[calc(100vh-65px)]" aria-labelledby="hero-heading">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <h1 id="hero-heading" class="text-6xl font-bold">Track your gear. Run your rentals.</h1>
      <p class="py-6 text-base-content/60">Open Source &middot; No Lock-in &middot; Docker Ready</p>
      <nav aria-label="Page sections" class="mt-2">
        <div class="flex flex-wrap gap-2 justify-center">
          <div class="tooltip" data-tip="Email: demo@gearberg.org & Password: demo@gearberg.org">
            <a href="https://demo.gearberg.org" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Try Demo</a>
          </div>
          <a href="#pricing" class="btn btn-outline">See Plans</a>
        </div>
      </nav>
    </div>
  </div>
</section>

{{/* Features */}}
<section id="features" class="py-24 bg-base-100" aria-labelledby="features-heading">
  <div class="container mx-auto px-6 max-w-7xl">
    <h2 id="features-heading" class="text-4xl font-bold text-center mb-16">Features</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <div class="card bg-base-200 shadow">
        <div class="card-body">
          <h3 class="card-title text-xl text-primary font-bold">
            {{ template "inventory-icon" . }}
            Equipment
          </h3>
          <p>Bulk quantities or serialized items, with categories and photos.</p>
        </div>
      </div>

      <div class="card bg-base-200 shadow">
        <div class="card-body">
          <h3 class="card-title text-xl text-primary font-bold">
            {{ template "rentals-icon" . }}
            Rentals
          </h3>
          <p>Check out gear to people, set due dates, track returns.</p>
        </div>
      </div>

      <div class="card bg-base-200 shadow">
        <div class="card-body">
          <h3 class="card-title text-xl text-primary font-bold">
            {{ template "free-icon" . }}
            Import &amp; Export
          </h3>
          <p>CSV in, CSV out. Your data is never locked in.</p>
        </div>
      </div>

      <div class="card bg-base-200 shadow" id="open-source">
        <div class="card-body">
          <h3 class="card-title text-xl text-primary font-bold">
            {{ template "open-source-icon" . }}
            Open Source
          </h3>
          <p>AGPL v3. Self-host it, audit it, contribute to it. <a href="https://github.com/bit8bytes/gearberg" class="link link-hover" target="_blank" rel="noopener noreferrer">View on GitHub.</a></p>
        </div>
      </div>

    </div>
  </div>
</section>

{{/* Pricing */}}
<section id="pricing" class="py-24 bg-base-200" aria-labelledby="pricing-heading">
  <div class="container mx-auto px-6 max-w-7xl text-center">
    <h2 id="pricing-heading" class="text-4xl font-bold mb-4">Pricing</h2>
    <p class="text-base-content/60 mb-12">Self-host for free, or wait for the desktop app. Cloud sync is coming for those who need it.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="card bg-base-100 shadow border border-base-300 opacity-60">
        <div class="card-body text-left">
          <div class="flex items-center gap-2 mb-1">
            <h3 class="card-title text-2xl font-bold">Desktop</h3>
            <span class="badge badge-ghost badge-sm">Coming soon</span>
          </div>
          <p class="text-4xl font-bold mt-2">Free</p>
          <p class="text-base-content/60 text-sm mb-4">No server, no Docker, just install and run. Requires Chrome.</p>
          <ul class="space-y-2 text-sm flex-1">
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Equipment</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Import &amp; Export</li>
          </ul>
          <div class="card-actions mt-6">
            <button class="btn btn-outline w-full" disabled>Not yet available</button>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow border border-base-300">
        <div class="card-body text-left">
          <h3 class="card-title text-2xl font-bold">Self-host</h3>
          <p class="text-4xl font-bold mt-2">Free</p>
          <p class="text-base-content/60 text-sm mb-4">Run on your own server with Docker</p>
          <ul class="space-y-2 text-sm flex-1">
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Equipment</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Rentals</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Import &amp; Export</li>
          </ul>
          <div class="card-actions mt-6">
            <a href="#quickstart" class="btn btn-outline w-full">Run with Docker</a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow border border-base-300">
        <div class="card-body text-left">
          <h3 class="card-title text-2xl font-bold">Cloud</h3>
          <p class="text-4xl font-bold mt-2">By request</p>
          <p class="text-base-content/60 text-sm mb-4">The software is free. You pay for the convenience of not running it yourself</p>
          <ul class="space-y-2 text-sm flex-1">
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Equipment</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Rentals</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Import &amp; Export</li>

          </ul>
          <div class="card-actions mt-6">
            <a href="mailto:gearberg@bit8bytes.com" class="btn btn-outline w-full">Get in touch</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

