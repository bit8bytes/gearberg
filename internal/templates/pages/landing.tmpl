{{ define "title" }}Equipment &amp; Rental Management{{ end }}
{{ define "description" }}Track your gear. Run your rentals. Open-source with no lock-in.{{ end }}

{{ define "seo" }}
<meta property="og:type" content="website" />
<meta property="og:title" content="Gearberg: Track your gear. Run your rentals." />
<meta property="og:description" content="Track your gear. Run your rentals. Open-source with no lock-in." />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content="Gearberg: Track your gear. Run your rentals." />
<meta name="twitter:description" content="Track your gear. Run your rentals. Open-source with no lock-in." />
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Gearberg",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Linux, macOS, Windows",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "license": "https://www.gnu.org/licenses/agpl-3.0.html",
  "url": "https://github.com/bit8bytes/gearberg",
  "description": "Track your gear. Run your rentals. Open-source with no lock-in.",
  "keywords": "inventory management, rental management, self-hosted, open source, equipment tracking"
}
</script>
{{ end }}

{{ define "page" }}
<main>
{{/* Hero Section */}}
<section class="hero min-h-[calc(100vh-65px)]" aria-labelledby="hero-heading">
  <div class="hero-content flex-col gap-8 py-12 w-full max-w-5xl">
    <div class="max-w-2xl text-center">
      <h1 id="hero-heading" class="text-3xl sm:text-5xl font-bold leading-tight">
        Easy to use and<br class="sm:hidden"> affordable <span class="text-primary">Rentman alternative</span>
      </h1>
      <p class="mt-6 text-lg text-base-content/70 max-w-lg mx-auto">
        Simple equipment tracking and rentals. 
        No lock-in. 
        Self-host with a single Docker command.
      </p>
      <nav aria-label="Page sections" class="mt-8">
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="#quickstart" class="btn btn-primary">Quickstart</a>
          <a href="#pricing" class="btn btn-outline">Pricing</a>
        </div>
      </nav>
    </div>
    <figure class="w-full">
      <img
        src="/dist/gearberg-1440.webp"
        srcset="/dist/gearberg-680.webp 680w, /dist/gearberg-1440.webp 1440w"
        sizes="(max-width: 768px) 680px, 1440px"
        alt="Gearberg equipment management interface"
        class="w-full rounded-xl shadow-xl border border-base-300"
        width="1440"
        height="755"
        fetchpriority="high"
      />
    </figure>
    </div>
</section>

{{/* Why use Gearberg? */}}
<section id="why" class="py-24 bg-base-100" aria-labelledby="why-heading">
  <div class="container mx-auto px-6 max-w-5xl">
    <div class="text-center mb-16">
      <h2 id="why-heading" class="text-4xl font-bold">Why use Gearberg?</h2>
      <p class="mt-4 text-base-content/70 max-w-xl mx-auto">Rentman is overkill for most shops. Gearberg gives you clear, useful tracking without complexity, training or prior experience.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <div class="flex items-start gap-4 p-6 rounded-xl bg-base-200">
        <span class="text-success">{{ template "check-icon" . }}</span>
        <div>
          <h3 class="font-semibold text-lg">Equipment</h3>
          <p class="text-base-content/70 mt-1">Bulk quantities or serialized items, with categories and photos.</p>
        </div>
      </div>

      <div class="flex items-start gap-4 p-6 rounded-xl bg-base-200">
        <span class="text-success">{{ template "check-icon" . }}</span>
        <div>
          <h3 class="font-semibold text-lg">Rentals</h3>
          <p class="text-base-content/70 mt-1">Check out gear to people, set due dates, track returns.</p>
        </div>
      </div>

      <div class="flex items-start gap-4 p-6 rounded-xl bg-base-200">
        <span class="text-success">{{ template "check-icon" . }}</span>
        <div>
          <h3 class="font-semibold text-lg">Import &amp; Export</h3>
          <p class="text-base-content/70 mt-1">CSV in, CSV out. Your data is never locked in.</p>
        </div>
      </div>

      <div class="flex items-start gap-4 p-6 rounded-xl bg-base-200" id="open-source">
        <span class="text-success">{{ template "check-icon" . }}</span>
        <div>
          <h3 class="font-semibold text-lg">Open Source</h3>
          <p class="text-base-content/70 mt-1">AGPL v3. Self-host it, audit it, contribute to it. <a href="https://github.com/bit8bytes/gearberg" class="link link-hover" target="_blank" rel="noopener noreferrer">View on GitHub.</a></p>
        </div>
      </div>

    </div>
  </div>
</section>

{{/* Pricing */}}
<section id="pricing" class="py-24" aria-labelledby="pricing-heading">
  <div class="container mx-auto px-6 max-w-3xl text-center">
    <h2 id="pricing-heading" class="text-4xl font-bold mb-4">Pricing</h2>
    <p class="text-base-content/80 mb-12">Self-host for free with all features included. Managed, worry-free cloud on request.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <div class="card bg-primary/10 shadow border border-primary">
        <div class="card-body text-left">
          <h3 class="card-title text-2xl font-bold">Self-host</h3>
          <p class="text-4xl font-bold mt-2 underline text-primary">Free</p>
          <p class="text-base-content/80 text-sm mb-4">Run on your own server with Docker</p>
          <ul class="space-y-2 text-sm flex-1">
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Equipment</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Rentals</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Import &amp; Export</li>
          </ul>
          <div class="card-actions mt-6">
            <a href="#quickstart" class="btn btn-outline w-full">Run with Docker</a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow border border-base-300">
        <div class="card-body text-left">
          <h3 class="card-title text-2xl font-bold">Cloud</h3>
          <p class="text-4xl font-bold mt-2">By request</p>
          <p class="text-base-content/80 text-sm mb-4">The software is free. You pay for the convenience of not running it yourself</p>
          <ul class="space-y-2 text-sm flex-1">
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Equipment</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Rentals</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Import &amp; Export</li>

          </ul>
          <div class="card-actions mt-6">
            <a href="mailto:gearberg@bit8bytes.com" class="btn btn-outline w-full">Get in touch</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

