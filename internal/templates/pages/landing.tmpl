{{ define "title" }}Equipment Management Software{{ end }}
{{ define "description" }}Know what you own, where it is, and what it's worth. Open-source equipment tracking with no lock-in.{{ end }}

{{ define "seo" }}
<meta property="og:type" content="website" />
<meta property="og:title" content="Gearberg: Know where your gear is." />
<meta property="og:description" content="Know what you own, where it is, and what it's worth. Open-source equipment tracking with no lock-in." />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content="Gearberg: Know where your gear is." />
<meta name="twitter:description" content="Know what you own, where it is, and what it's worth. Open-source equipment tracking with no lock-in." />
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Gearberg",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Linux, macOS, Windows",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "license": "https://www.gnu.org/licenses/agpl-3.0.html",
  "url": "https://github.com/bit8bytes/gearberg",
  "description": "Know what you own, where it is, and what it's worth. Open-source equipment tracking with no lock-in.",
  "keywords": "AV equipment tracking, inventory management, audio visual gear, asset management, self-hosted, open source"
}
</script>
{{ end }}

{{ define "page" }}
<main>
{{/* Hero Section */}}
<section class="hero min-h-[calc(100vh-65px)]" aria-labelledby="hero-heading">
  <div class="hero-content flex-col gap-8 py-12 w-full max-w-5xl">
    <div class="max-w-2xl text-center">
      <h1 id="hero-heading" class="text-4xl sm:text-5xl font-bold leading-tight">
        Open-Source <br>AV Equipment Software
      </h1>
      <p class="mt-6 text-lg text-base-content/70 max-w-lg mx-auto">
        Simple equipment tracking for individuals and small teams. No spreadsheets, no vendor risk. Self-host with a single Docker command.
      </p>
      <nav aria-label="Page sections" class="mt-8">
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="#quickstart" class="btn btn-primary">Quickstart</a>
          <a href="#pricing" class="btn btn-outline">Pricing</a>
        </div>
      </nav>
    </div>
    <figure class="w-full">
      <img
        src="/dist/gearberg-1440.webp"
        srcset="/dist/gearberg-680.webp 680w, /dist/gearberg-1440.webp 1440w"
        sizes="(max-width: 768px) 680px, 1440px"
        alt="Gearberg equipment management interface"
        class="w-full rounded-xl shadow-xl border border-base-300"
        width="1440"
        height="755"
        fetchpriority="high"
      />
    </figure>
    </div>
</section>

{{/* Why use Gearberg? */}}
<section id="why" class="py-24 bg-base-100" aria-labelledby="why-heading">
  <div class="container mx-auto px-6 max-w-5xl">
    <div class="text-center mb-16">
      <h2 id="why-heading" class="text-3xl font-bold">Why use Gearberg?</h2>
      <p class="mt-4 text-base-content/70 max-w-xl mx-auto">Most equipment software is built for enterprises. Gearberg gives AV freelancers and small production teams exactly what they need: clear, useful tracking without the complexity, training, or price tag.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <div class="flex items-start gap-4">
        <span class="text-success">{{ template "check-icon" . }}</span>
        <div>
          <h3 class="font-semibold">Know where your gear is</h3>
          <p class="text-base-content/70 mt-1">That lens you lent out three weeks ago? Gearberg tells you exactly who has it, when it's due back, and what's still on the shelf.</p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <span class="text-success">{{ template "check-icon" . }}</span>
        <div>
          <h3 class="font-semibold">Always know what you have</h3>
          <p class="text-base-content/70 mt-1">Every piece of gear in one place. Model, serial number, location — instantly searchable, no spreadsheet hunting.</p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <span class="text-success">{{ template "check-icon" . }}</span>
        <div>
          <h3 class="font-semibold">Know what your inventory is worth</h3>
          <p class="text-base-content/70 mt-1">See the total value of everything you own at a glance. Useful for insurance coverage, purchasing decisions, and conversations with your accountant.</p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <span class="text-success">{{ template "check-icon" . }}</span>
        <div>
          <h3 class="font-semibold">Your data, your terms</h3>
          <p class="text-base-content/70 mt-1">Bring in your existing gear list from CSV and export it anytime. Nothing is ever trapped inside Gearberg.</p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <span class="text-success">{{ template "check-icon" . }}</span>
        <div>
          <h3 class="font-semibold">Kits that travel together</h3>
          <p class="text-base-content/70 mt-1">Group your cables, stands, and lights into a kit. Track the whole set as one unit and know instantly if anything is missing.</p>
        </div>
      </div>

      <div class="flex items-start gap-4" id="open-source">
        <span class="text-success">{{ template "check-icon" . }}</span>
        <div>
          <h3 class="font-semibold">Open source, self-hostable</h3>
          <p class="text-base-content/70 mt-1">AGPL v3. Run it on your own server, read the code, and contribute. No vendor risk. <a href="https://github.com/bit8bytes/gearberg" class="link link-hover" target="_blank" rel="noopener noreferrer">View on GitHub.</a></p>
        </div>
      </div>

    </div>
  </div>
</section>

{{/* Pricing */}}
<section id="pricing" class="py-24" aria-labelledby="pricing-heading">
  <div class="container mx-auto px-6 max-w-3xl text-center">
    <h2 id="pricing-heading" class="text-3xl font-bold mb-4">Pricing</h2>
    <p class="text-base-content/80 mb-12">Open Source is free. Prefer not to manage a server? Just reach out.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <div class="card bg-base-100 shadow border border-base-300">
        <div class="card-body text-left">
          <h3 class="card-title font-bold">Self-host</h3>
          <p class="text-2xl font-bold mt-2 underline">Free</p>
          <p class="text-base-content/80 text-sm mb-4">Run on your own server with Docker</p>
          <ul class="space-y-2 text-sm flex-1">
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Equipment tracking</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Kits &amp; combinations</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Import &amp; Export</li>
          </ul>
          <div class="card-actions mt-6">
            <a href="#quickstart" class="btn btn-outline w-full">Run with Docker</a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow border border-base-300">
        <div class="card-body text-left">
          <h3 class="card-title font-bold">Cloud</h3>
          <p class="text-2xl font-bold mt-2 underline">By request</p>
          <p class="text-base-content/80 text-sm mb-4">The software is free. You pay for the convenience of not running it yourself.</p>
          <ul class="space-y-2 text-sm flex-1">
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Equipment tracking</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Kits &amp; combinations</li>
            <li class="flex items-center gap-2">{{ template "success-icon" . }} Import &amp; Export</li>
          </ul>
          <div class="card-actions mt-6">
            <a href="mailto:gearberg@bit8bytes.com" class="btn btn-outline w-full">Get in touch</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{{/* Quickstart */}}
<section id="quickstart" class="py-24 bg-base-100" aria-labelledby="quickstart-heading">
  <div class="container mx-auto px-6 max-w-3xl">
    <h2 id="quickstart-heading" class="text-3xl font-bold text-center mb-4">Quickstart</h2>
    <p class="text-center mb-10">Try it with a single <a href="https://docker.com" class="link link-primary" target="_blank" rel="noopener noreferrer">Docker</a> command:</p>

    <div class="mockup-code relative" role="region" aria-label="Quickstart command">
      <button
        id="copy-quickstart"
        class="absolute top-3 right-3 btn btn-xs btn-neutral"
        aria-label="Copy command to clipboard"
      >Copy</button>
      <pre data-prefix="$"><code>docker run -p 8080:8080 ghcr.io/bit8bytes/gearberg serve</code></pre>
    </div>
    <script nonce="{{ .Nonce }}">
      document.getElementById('copy-quickstart').addEventListener('click', function() {
        navigator.clipboard.writeText('docker run -p 8080:8080 ghcr.io/bit8bytes/gearberg serve');
        this.textContent = 'Copied!';
      });
    </script>

    <p class="text-center mt-6">Then open <a href="http://localhost:8080" class="badge badge-neutral font-mono" target="_blank" rel="noopener noreferrer">http://localhost:8080</a> in your browser.</p>
  </div>
</section>

{{/* FAQ */}}
<section id="faq" class="py-24 bg-base-100" aria-labelledby="faq-heading">
  <div class="container mx-auto px-6 max-w-3xl">
    <h2 id="faq-heading" class="text-3xl font-bold text-center mb-12">Frequently Asked Questions</h2>
    <div class="space-y-3">

      <details class="collapse collapse-arrow bg-base-200">
        <summary class="collapse-title text-lg font-medium">Who is Gearberg for?</summary>
        <div class="collapse-content">
          <p>Individuals and small teams who need a clear overview of their equipment — without the complexity of enterprise asset management software.</p>
        </div>
      </details>

      <details class="collapse collapse-arrow bg-base-200">
        <summary class="collapse-title text-lg font-medium">What problems does Gearberg solve?</summary>
        <div class="collapse-content">
          <p>Knowing what gear you own, where it is, what it's worth, and whether it's available. Without spreadsheets or expensive software.</p>
        </div>
      </details>

      <details class="collapse collapse-arrow bg-base-200">
        <summary class="collapse-title text-lg font-medium">Can I export my data?</summary>
        <div class="collapse-content">
          <p>Yes. Export your equipment list as CSV at any time. Your data is yours and never gets locked inside Gearberg.</p>
        </div>
      </details>

      <details class="collapse collapse-arrow bg-base-200">
        <summary class="collapse-title text-lg font-medium">What license is Gearberg released under?</summary>
        <div class="collapse-content">
          <p>Gearberg is licensed under the <a href="https://www.gnu.org/licenses/agpl-3.0.html" class="link link-primary" target="_blank" rel="noopener noreferrer">AGPL-3.0</a>. You can use, study, modify, and distribute it. Any modifications you deploy over a network must be released under the same license.</p>
        </div>
      </details>

      <details class="collapse collapse-arrow bg-base-200">
        <summary class="collapse-title text-lg font-medium">What if I want to go back to spreadsheets?</summary>
        <div class="collapse-content">
          <p>We respect that. Export your full equipment list as CSV at any time and take it wherever you like, including back to a spreadsheet. We call it the Back-to-Spreadsheets Guarantee, and we mean it.</p>
        </div>
      </details>

    </div>
  </div>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who is Gearberg for?",
        "acceptedAnswer": { "@type": "Answer", "text": "Individuals and small teams who need a clear overview of their equipment — without the complexity of enterprise asset management software." }
      },
      {
        "@type": "Question",
        "name": "What problems does Gearberg solve?",
        "acceptedAnswer": { "@type": "Answer", "text": "Knowing what gear you own, where it is, what it's worth, and whether it's available. Without spreadsheets or expensive software." }
      },
      {
        "@type": "Question",
        "name": "Can I export my data?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Export your equipment list as CSV at any time. Your data is yours and never gets locked inside Gearberg." }
      },
      {
        "@type": "Question",
        "name": "Can I move my data between self-hosted and managed?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Export your equipment data as CSV from any Gearberg instance and import it into any other. It works in both directions: self-hosted to managed, or managed to self-hosted. Your data is never locked in." }
      },
      {
        "@type": "Question",
        "name": "What license is Gearberg released under?",
        "acceptedAnswer": { "@type": "Answer", "text": "Gearberg is licensed under the AGPL-3.0. You can use, study, modify, and distribute it, provided any modifications you deploy over a network are released under the same license." }
      },
      {
        "@type": "Question",
        "name": "What if I want to go back to spreadsheets?",
        "acceptedAnswer": { "@type": "Answer", "text": "Export your full equipment list as CSV at any time and take it wherever you like, including back to a spreadsheet. We call it the Back-to-Spreadsheets Guarantee." }
      }
    ]
  }
  </script>
</section>

{{/* Closing CTA */}}
<section class="py-24" aria-labelledby="cta-heading">
  <div class="container mx-auto px-6 max-w-xl text-center">
    <h2 id="cta-heading" class="text-3xl font-bold mb-4">Ready to finally know where your gear is?</h2>
    <p class="text-base-content/80 mb-8">Run Gearberg in under a minute, or get in touch if you'd like us to run it for you.</p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="#quickstart" class="btn btn-primary">Run with Docker</a>
      <a href="mailto:gearberg@bit8bytes.com" class="btn btn-outline">Get in touch</a>
    </div>
  </div>
</section>

<a href="#" class="btn btn-circle btn-primary fixed bottom-6 right-6 shadow-lg" aria-label="Scroll to top">
  {{ template "chevron-up" . }}
</a>

</main>
{{ end }}
