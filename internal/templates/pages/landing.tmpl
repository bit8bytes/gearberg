{{/* Quickstart */}}
<section id="quickstart" class="py-24 bg-base-100" aria-labelledby="quickstart-heading">
  <div class="container mx-auto px-6 max-w-3xl">
    <h2 id="quickstart-heading" class="text-4xl font-bold text-center mb-4">Quickstart</h2>
    <p class="text-center mb-10">Try it with a single <a href="https://docker.com" class="link link-primary" target="_blank" rel="noopener noreferrer">Docker</a> command:</p>

    <div class="mockup-code relative" role="region" aria-label="Quickstart command">
      <button
        id="copy-quickstart"
        class="absolute top-3 right-3 btn btn-xs btn-neutral"
        aria-label="Copy command to clipboard"
      >Copy</button>
      <pre data-prefix="$"><code>docker run -p 8080:8080 ghcr.io/bit8bytes/gearberg serve</code></pre>
    </div>
    <script nonce="{{ .Nonce }}">
      document.getElementById('copy-quickstart').addEventListener('click', function() {
        navigator.clipboard.writeText('docker run -p 8080:8080 ghcr.io/bit8bytes/gearberg serve');
        this.textContent = 'Copied!';
      });
    </script>

    <p class="text-center mt-6">Then open <a href="http://localhost:8080" class="badge badge-neutral font-mono" target="_blank" rel="noopener noreferrer">http://localhost:8080</a> in your browser.</p>
  </div>
</section>

{{/* FAQ */}}
<section id="faq" class="py-24 bg-base-100" aria-labelledby="faq-heading">
  <div class="container mx-auto px-6 max-w-3xl">
    <h2 id="faq-heading" class="text-4xl font-bold text-center mb-12">Frequently Asked Questions</h2>
    <div class="space-y-3">

      <details class="collapse collapse-arrow bg-base-200">
        <summary class="collapse-title text-lg font-medium">Who is Gearberg for?</summary>
        <div class="collapse-content">
          <p>Individuals, freelancers, and small businesses who need straightforward equipment tracking and rentals.</p>
        </div>
      </details>

      <details class="collapse collapse-arrow bg-base-200">
        <summary class="collapse-title text-lg font-medium">What problems does Gearberg solve?</summary>
        <div class="collapse-content">
          <p>Knowing what gear you own, where it is, and whether it's available. Without spreadsheets or expensive rental software.</p>
        </div>
      </details>

      <details class="collapse collapse-arrow bg-base-200">
        <summary class="collapse-title text-lg font-medium">Can I export my data?</summary>
        <div class="collapse-content">
          <p>Yes. Export your equipment list as CSV at any time.</p>
        </div>
      </details>

      <details class="collapse collapse-arrow bg-base-200">
        <summary class="collapse-title text-lg font-medium">What license is Gearberg released under?</summary>
        <div class="collapse-content">
          <p>Gearberg is licensed under the <a href="https://www.gnu.org/licenses/agpl-3.0.html" class="link link-primary" target="_blank" rel="noopener noreferrer">AGPL-3.0</a>. You can use, study, modify, and distribute it. Any modifications you deploy over a network must be released under the same license.</p>
        </div>
      </details>

    </div>
  </div>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who is Gearberg for?",
        "acceptedAnswer": { "@type": "Answer", "text": "Small teams, clubs, schools, and studios that need to track shared equipment and rentals without spreadsheets or expensive SaaS tools." }
      },
      {
        "@type": "Question",
        "name": "What problems does Gearberg solve?",
        "acceptedAnswer": { "@type": "Answer", "text": "Knowing what gear you own, where it is, and whether it's available. Without spreadsheets or expensive rental software." }
      },
      {
        "@type": "Question",
        "name": "What's the difference between self-hosted and desktop?",
        "acceptedAnswer": { "@type": "Answer", "text": "Self-hosted is free. You run it on your own server with Docker and get all features, including rentals. The desktop app is also free and works without a server, but covers equipment tracking only. A cloud option with multi-device sync and rentals is planned for the future." }
      },
      {
        "@type": "Question",
        "name": "Can I move my data between self-hosted and managed?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Export your equipment data as CSV from any Gearberg instance and import it into any other. It works in both directions: self-hosted to managed, or managed to self-hosted. Your data is never locked in." }
      },
      {
        "@type": "Question",
        "name": "What license is Gearberg released under?",
        "acceptedAnswer": { "@type": "Answer", "text": "Gearberg is licensed under the AGPL-3.0. You can use, study, modify, and distribute it, provided any modifications you deploy over a network are released under the same license." }
      }
    ]
  }
  </script>
</section>

{{/* Closing CTA */}}
<section class="py-24" aria-labelledby="cta-heading">
  <div class="container mx-auto px-6 max-w-xl text-center">
    <h2 id="cta-heading" class="text-4xl font-bold mb-4">Ready to get started?</h2>
    <p class="text-base-content/80 mb-8">Try the demo or run it yourself with a single Docker command.</p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="#quickstart" class="btn btn-primary">Run with Docker</a>
      <a href="mailto:gearberg@bit8bytes.com" class="btn btn-outline">Get in touch</a>
    </div>
  </div>
</section>

<a href="#" class="btn btn-circle btn-primary fixed bottom-6 right-6 shadow-lg" aria-label="Scroll to top">
  {{ template "chevron-up" . }}
</a>

</main>
{{ end }}
