{{ define "password-validation" }}
{{ $valid := and .Form.Password (not (index .Form.Errors "password")) }}
<div id="password-validation" class="flex flex-col gap-1">
  <div class="relative">
    <label class="floating-label w-full">
      <input
        id="password"
        name="password"
        type="password"
        class="input w-full {{ if index .Form.Errors "password" }}input-error{{ else if $valid }}input-success{{ end }}"
        placeholder="Password"
        {{ if .Form.Password }}value="{{ .Form.Password }}"{{ end }}
        autocomplete="new-password"
        hx-post="/validate/password"
        hx-target="#password-validation"
        hx-swap="outerHTML"
        hx-trigger="input changed delay:500ms"
        {{ if index .Form.Errors "password" }}aria-describedby="password-error" aria-invalid="true"{{ end }}
      />
      <span>Password</span>
    </label>
    <button
      type="button"
      data-pw-toggle="password"
      class="absolute right-2 top-1/2 -translate-y-1/2 btn btn-ghost btn-xs text-secondary-content"
      aria-label="Show password"
      aria-pressed="false"
    >Show</button>
  </div>
  {{ if index .Form.Errors "password" }}
  <div class="label">
    <span id="password-error" class="label-text-alt text-error">{{ index .Form.Errors "password" }}</span>
  </div>
  {{ else if $valid }}
  <div class="label">
    <span class="label-text-alt text-success">Password looks good</span>
  </div>
  {{ end }}
</div>
{{ end }}
