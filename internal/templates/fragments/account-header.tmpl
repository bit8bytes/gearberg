{{ define "account-header" }}
<div class="flex items-center gap-1">
  <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar avatar-placeholder">
    <div class="bg-neutral text-neutral-content w-24 rounded-full">
      <span>{{ .Data.Initials }}</span>
    </div>
  </div>
  <div class="flex flex-col min-w-0">
    {{ if .Data.OrgName }}<span class="text-xs font-semibold truncate">{{ .Data.OrgName }}</span>{{ end }}
    <span class="truncate text-xs text-base-content/60">{{ .Data.Email }}</span>
  </div>
</div>
{{ end }}

{{ define "account-header-skeleton" }}
<div class="flex items-center gap-1">
  <div class="skeleton btn-circle w-10 h-10 rounded-full"></div>
  <div class="flex flex-col gap-1">
    <div class="skeleton h-3 w-24 rounded"></div>
    <div class="skeleton h-3 w-32 rounded"></div>
  </div>
</div>
{{ end }}
